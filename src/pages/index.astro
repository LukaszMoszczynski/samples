---
// Samples index: every Astro sample in samples/*/sample.json, newest first, with a live scaled-down preview, the
// sample's own colours, its visual direction and a short description. Styled like the owner's portfolio.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import og from '../assets/og.jpg?url';
import favicon from '../assets/favicon.svg?url';
import touchIcon from '../assets/apple-touch-icon.png?url';

interface SampleMeta { slug: string; stack: string; title: string; summary?: string; direction?: string; tags?: string[]; date?: string }
const files = import.meta.glob<SampleMeta>('../../samples/*/sample.json', { eager: true, import: 'default' });
const base = import.meta.env.BASE_URL;

// The sample's own palette, read from its brand.css (primary, accent, page), shown as three swatches.
function swatches(slug: string): string[] {
  try {
    const css = readFileSync(join(process.cwd(), 'samples', slug, 'brand.css'), 'utf8');
    return ['--palette-primary-600', '--palette-accent-400', '--palette-neutral-50']
      .map((name) => css.match(new RegExp(`${name}:\\s*([^;]+);`))?.[1].trim())
      .filter((value): value is string => Boolean(value));
  } catch {
    return [];
  }
}

const samples = Object.values(files)
  .filter((sample) => sample.stack === 'astro')
  .sort((first, second) => (second.date ?? '').localeCompare(first.date ?? ''))
  .map((sample) => ({ ...sample, name: sample.title.split(' – ')[0], colours: swatches(sample.slug) }));
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Przykładowe strony – Łukasz Moszczyński</title>
    <meta name="description" content="Przykładowe strony przygotowane pod konkretne briefy: własny wygląd, animacje, jeden design system." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Przykładowe strony – Łukasz Moszczyński" />
    <meta property="og:description" content="Przykładowe strony przygotowane pod konkretne briefy: własny wygląd, animacje, jeden design system." />
    <meta property="og:url" content={new URL(base, Astro.site).href} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={new URL(og, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={touchIcon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Manrope:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <style>
      :root {
        --bg: #0d0a15;
        --surface: #1a1429;
        --card: #1f1832;
        --ink: #f4f0fb;
        --muted: #b6a9d4;
        --line: #2a2140;
        --grid: #1b1528;
        --accent: #f07a3e;
        --focus: #f07a3e;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 64px 64px,
          linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 64px 64px,
          radial-gradient(circle at 15% 0%, rgb(240 122 62 / 0.12), transparent 40%),
          var(--bg);
        color: var(--ink);
        font: 400 16px/1.6 "Manrope", system-ui, sans-serif;
      }

      .wrap {
        max-width: 1240px;
        margin: 0 auto;
        padding-block: 72px 96px;
        padding-left: max(24px, env(safe-area-inset-left, 0px));
        padding-right: max(24px, env(safe-area-inset-right, 0px));
      }

      .back {
        display: inline-block;
        margin-bottom: 56px;
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
      }

      .back:hover {
        color: var(--ink);
      }

      .kicker {
        margin: 0 0 12px;
        font: 400 13px/1.4 "IBM Plex Mono", ui-monospace, monospace;
        color: var(--accent);
      }

      h1 {
        max-width: 18ch;
        margin: 0 0 20px;
        font: 700 clamp(34px, 6vw, 72px)/1.02 "Unbounded", "Arial Black", sans-serif;
        letter-spacing: -0.035em;
        text-wrap: balance;
      }

      h1 .dot {
        color: var(--accent);
      }

      .lead {
        max-width: 60ch;
        margin: 0 0 64px;
        font-size: 18px;
        color: var(--muted);
      }

      .list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
        gap: 28px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .card {
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr;
        align-content: start;
        height: 100%;
        border-radius: 24px;
        background: var(--card);
        box-shadow: 0 0 0 1px var(--line), 0 30px 60px -30px rgb(10 5 25 / 0.8);
        color: inherit;
        text-decoration: none;
        overflow: hidden;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
      }

      .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 0 0 1px var(--accent), 0 40px 70px -30px rgb(240 122 62 / 0.35);
      }

      .card-link {
        color: inherit;
        text-decoration: none;
      }

      .card-link::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: 24px;
      }

      .card-link:focus-visible {
        outline: none;
      }

      .card:has(.card-link:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: 4px;
      }

      .preview {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: var(--surface);
        border-bottom: 1px solid var(--line);
      }

      .preview iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 1440px;
        height: 900px;
        border: 0;
        transform-origin: 0 0;
        transform: scale(var(--scale, 0.27));
        pointer-events: none;
      }

      .body {
        display: grid;
        align-content: start;
        gap: 12px;
        padding: 24px 26px 28px;
      }

      .meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font: 400 12px/1.4 "IBM Plex Mono", ui-monospace, monospace;
        color: var(--muted);
      }

      .swatches {
        display: flex;
        gap: 6px;
      }

      .swatch {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25);
      }

      h2 {
        margin: 0;
        font: 700 22px/1.2 "Unbounded", "Arial Black", sans-serif;
        letter-spacing: -0.02em;
      }

      .summary {
        margin: 0;
        color: var(--muted);
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 4px 0 0;
        padding: 0;
        list-style: none;
      }

      .tags li {
        padding: 4px 10px;
        border-radius: 999px;
        background: var(--surface);
        box-shadow: inset 0 0 0 1px var(--line);
        font-size: 13px;
      }

      .open {
        margin-top: 6px;
        font-weight: 600;
        color: var(--accent);
      }

      .open span {
        display: inline-block;
        transition: transform 0.3s ease;
      }

      .card:hover .open span {
        transform: translateX(4px);
      }

      .note {
        margin: 56px 0 0;
        font-size: 14px;
        color: var(--muted);
      }

      .note a {
        color: var(--ink);
      }

      @media (prefers-reduced-motion: reduce) {
        .card,
        .open span {
          transition: none;
        }

        .card:hover {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <a class="back" href="https://lukaszmoszczynski.github.io/">← Portfolio</a>
      <p class="kicker">Przykładowe strony</p>
      <h1>Strony szyte pod brief<span class="dot">.</span></h1>
      <p class="lead">Każda z tych stron powstała pod konkretne zlecenie: własny wygląd i komponenty, animacje, które pokazują, jak strona się zachowuje, i jeden design system pod spodem. Kliknij, żeby zobaczyć ją na żywo.</p>
      <ul class="list" role="list">
        {samples.map((sample) => (
          <li>
            <article class="card">
              <div class="preview" aria-hidden="true">
                <iframe src={`${base}${sample.slug}/`} title="" tabindex="-1" loading="lazy" data-preview></iframe>
              </div>
              <div class="body">
                <div class="meta">
                  <span>{sample.direction ?? ''}{sample.date ? ` · ${sample.date}` : ''}</span>
                  <span class="swatches" aria-hidden="true">{sample.colours.map((colour) => <span class="swatch" style={`background:${colour}`}></span>)}</span>
                </div>
                <h2><a class="card-link" href={`${base}${sample.slug}/`}>{sample.name}</a></h2>
                {sample.summary && <p class="summary">{sample.summary}</p>}
                {sample.tags && <ul class="tags" role="list">{sample.tags.map((tag) => <li>{tag}</li>)}</ul>}
                <span class="open" aria-hidden="true">Zobacz na żywo <span>→</span></span>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <p class="note">Przykładowe treści i grafiki; w gotowej stronie zastępują je materiały klienta. Więcej o mnie: <a href="https://lukaszmoszczynski.github.io/">portfolio</a>.</p>
    </main>
    <script is:inline>
      // Fit each 1440 × 900 live preview to its card.
      function fit() {
        document.querySelectorAll('[data-preview]').forEach(function (frame) {
          frame.style.setProperty('--scale', String(frame.parentElement.clientWidth / 1440));
        });
      }
      fit();
      addEventListener('resize', fit);
    </script>
  </body>
</html>
