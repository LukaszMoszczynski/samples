---
// Samples index, the main page that sells: a short promise, the samples as a designer list (hover paints the row in
// the sample's colour and shows its preview), what a client gets, and one way to get in touch. The burger opens the
// same list as a full-screen menu; every sample carries that burger too (layouts/Sample.astro).
import og from '../assets/og.jpg?url';
import favicon from '../assets/favicon.svg?url';
import touchIcon from '../assets/apple-touch-icon.png?url';
import SamplesMenu from '../components/SamplesMenu.astro';
import SampleRows from '../components/SampleRows.astro';
import { sampleCards, CONTACT_URL, PORTFOLIO_URL } from '../components/samples-data';

const base = import.meta.env.BASE_URL;
const samples = sampleCards(base);
const description = 'Przykładowe strony przygotowane pod konkretne briefy: własny wygląd, animacje, dostępność i jeden design system pod spodem.';
const gets = [
  { title: 'Wygląd tylko dla Twojej marki', text: 'Własne komponenty, kolory i typografia z Twojej identyfikacji. Żadnego szablonu, który ma pół internetu.' },
  { title: 'Animacje, które coś mówią', text: 'Ruch pokazuje, jak działa oferta: rysujące się logo, trasa przesyłki, toczące się kółka. Płynnie, bez szarpania.' },
  { title: 'Dostępna dla każdego', text: 'Każda strona przechodzi automatyczny test WCAG 2.2 AA na telefonie i komputerze, zanim trafi do sieci.' },
  { title: 'Gotowa na treści i sprzedaż', text: 'WordPress ze sklepem, Payload albo czyste Astro: dobieram zaplecze do tego, jak będziesz z niej korzystać.' },
];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Przykładowe strony – Łukasz Moszczyński</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Przykładowe strony – Łukasz Moszczyński" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(base, Astro.site).href} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={new URL(og, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={touchIcon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Manrope:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) { var root = document.documentElement; root.setAttribute("data-motion", ""); setTimeout(function () { if (!root.hasAttribute("data-motion-ready")) root.removeAttribute("data-motion"); }, 4000); }</script>
    <style is:global>
      :root {
        --bg: #0d0a15;
        --ink: #f4f0fb;
        --muted: #b6a9d4;
        --line: rgb(244 240 251 / 0.14);
        --accent: #f07a3e;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 96px; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.6 "Manrope", system-ui, sans-serif; }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      [hidden] { display: none !important; }
      .wrap { max-width: 1240px; margin: 0 auto; padding-inline: 24px; }

      .top { position: fixed; inset: 0 0 auto; z-index: 47; pointer-events: none; }
      .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
      .top a, .top button { pointer-events: auto; }
      .brand { padding: 14px 20px; border-radius: 999px; background: rgb(13 10 21 / 0.72); backdrop-filter: blur(8px); color: var(--ink); font: 700 15px/1 "Unbounded", sans-serif; text-decoration: none; }
      .brand span { color: var(--accent); }
      .top-actions { display: flex; align-items: center; gap: 12px; }
      .talk { padding: 13px 20px; border: 1px solid rgb(244 240 251 / 0.35); border-radius: 999px; color: var(--ink); font-weight: 600; text-decoration: none; background: rgb(13 10 21 / 0.72); backdrop-filter: blur(8px); transition: border-color 0.3s ease; }
      .talk:hover { border-color: var(--accent); }

      .hero { position: relative; min-height: 100svh; display: grid; align-items: center; overflow: clip; padding-block: 140px 96px; }
      .orbs { position: absolute; inset: -10%; pointer-events: none; }
      .orb { position: absolute; width: 46vmax; aspect-ratio: 1; border-radius: 50%; opacity: 0.55;
        background: radial-gradient(circle, var(--orb) 0%, color-mix(in srgb, var(--orb) 35%, transparent) 35%, transparent 68%); }
      .grid-lines { position: absolute; inset: 0; pointer-events: none; opacity: 0.5;
        background: linear-gradient(rgb(244 240 251 / 0.04) 1px, transparent 1px) 0 0 / 72px 72px, linear-gradient(90deg, rgb(244 240 251 / 0.04) 1px, transparent 1px) 0 0 / 72px 72px; }
      .hero .wrap { position: relative; }
      .kicker { margin: 0 0 20px; color: var(--accent); font: 400 13px/1.4 "IBM Plex Mono", monospace; letter-spacing: 0.08em; text-transform: uppercase; }
      h1 { max-width: 14ch; margin: 0 0 28px; font: 700 clamp(40px, 7.4vw, 112px)/0.98 "Unbounded", "Arial Black", sans-serif; letter-spacing: -0.04em; }
      h1 .dot { color: var(--accent); }
      .h1-line { display: block; overflow: clip; padding-bottom: 0.04em; }
      .h1-line > span { display: inline-block; }
      .lead { max-width: 56ch; margin: 0 0 36px; color: var(--muted); font-size: clamp(17px, 1.4vw, 20px); }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; }
      .btn { display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; border-radius: 999px; font-weight: 600; text-decoration: none; transition: transform 0.3s ease; }
      .btn:hover { transform: translateY(-2px); }
      .btn span { transition: transform 0.3s ease; }
      .btn:hover span { transform: translateX(4px); }
      .btn--accent { background: var(--accent); color: var(--bg); }
      .btn--ghost { border: 1px solid rgb(244 240 251 / 0.35); color: var(--ink); }
      .scroll-cue { position: absolute; left: 50%; bottom: 28px; width: 2px; height: 56px; overflow: hidden; background: rgb(244 240 251 / 0.15); }
      .scroll-cue::after { content: ""; position: absolute; inset: 0; background: var(--accent); transform: translateY(-100%); animation: cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
      @keyframes cue { 50% { transform: translateY(0); } 100% { transform: translateY(100%); } }

      .section { padding-block: 120px; }
      .section-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 40px; margin-bottom: 40px; }
      .section-head h2 { margin: 0; font: 700 clamp(30px, 4vw, 56px)/1.05 "Unbounded", sans-serif; letter-spacing: -0.03em; }
      .section-head p { max-width: 44ch; margin: 0; color: var(--muted); }

      .gets { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 0; padding: 0; list-style: none; }
      .get { position: relative; padding: 32px 28px; border: 1px solid var(--line); border-radius: 24px; overflow: hidden; }
      .get::before { content: ""; position: absolute; top: -40%; right: -40%; width: 80%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(240 122 62 / 0.35), transparent 65%); transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
      .get:hover::before { transform: translate(-30%, 30%) scale(1.4); }
      .get-num { color: var(--accent); font: 400 13px/1 "IBM Plex Mono", monospace; }
      .get h3 { position: relative; margin: 20px 0 10px; font: 700 20px/1.2 "Unbounded", sans-serif; letter-spacing: -0.02em; }
      .get p { position: relative; margin: 0; color: var(--muted); }

      .final { position: relative; overflow: clip; margin-inline: 24px; padding: 96px 24px; border-radius: 40px; text-align: center; background: var(--accent); color: var(--bg); }
      .final h2 { max-width: 18ch; margin: 0 auto 20px; font: 700 clamp(32px, 5vw, 72px)/1.02 "Unbounded", sans-serif; letter-spacing: -0.035em; }
      .final p { max-width: 46ch; margin: 0 auto 32px; font-size: 18px; }
      .final .btn { background: var(--bg); color: var(--ink); }
      .final-ring { position: absolute; width: 520px; aspect-ratio: 1; border: 2px dashed rgb(13 10 21 / 0.25); border-radius: 50%; top: -260px; left: -160px; }
      .final-ring--2 { top: auto; left: auto; right: -200px; bottom: -300px; width: 640px; }

      .foot { padding-block: 48px; color: var(--muted); font-size: 14px; }
      .foot .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
      .foot a { color: var(--ink); }

      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      /* Journey: five full-screen panels that stick and stack, each sliding over the one before. */
      .journey { position: relative; }
      /* --stick: a panel taller than the screen sticks by its bottom edge (set in the script), so none of it is skipped. */
      .panel { position: sticky; top: var(--stick, 0px); min-height: 100svh; display: grid; align-items: center; overflow: clip; border-radius: 40px 40px 0 0; box-shadow: 0 -24px 60px rgb(0 0 0 / 0.35); }
      .panel--rose { background: #d92558; color: #ffffff; }
      .panel--plum { background: #57083b; color: #ffffff; }
      .panel--lemon { background: #fff584; color: #2b1230; }
      .panel--teal { background: #175b5d; color: #ffffff; }
      .panel--orange { background: #f07a3e; color: #0d0a15; }
      .panel__text a { color: inherit; text-underline-offset: 4px; }
      .panel__inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 56px; padding-block: 112px 72px; transform-origin: 50% 0; }
      .panel__inner--final { grid-template-columns: 1fr; justify-items: center; text-align: center; }
      .panel__step { margin: 0 0 18px; font: 500 14px/1 "IBM Plex Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
      .panel__title { margin: 0 0 22px; font: 700 clamp(34px, 4.6vw, 68px)/1.02 "Unbounded", sans-serif; letter-spacing: -0.035em; text-wrap: balance; }
      .panel__title--big { max-width: 16ch; font-size: clamp(40px, 6.6vw, 104px); }
      .panel__text { max-width: 46ch; margin: 0; font-size: clamp(17px, 1.4vw, 20px); }
      .panel__inner--final .panel__text { margin-bottom: 36px; }
      .btn--dark { background: #0d0a15; color: #f4f0fb; }
      .btn--line { border: 1px solid #0d0a15; color: #0d0a15; }

      .chat { display: grid; gap: 14px; max-width: 460px; margin-left: auto; }
      .bubble { padding: 16px 22px; border-radius: 24px; font-size: 18px; line-height: 1.4; }
      .bubble--in { justify-self: start; border-bottom-left-radius: 6px; background: #ffffff; color: #2b1230; }
      .bubble--out { justify-self: end; border-bottom-right-radius: 6px; background: #57083b; color: #ffffff; }

      .brandkit { position: relative; height: 380px; }
      .swatch-card { position: absolute; left: 50%; bottom: 0; width: 170px; height: 280px; margin-left: -85px; border-radius: 22px; background: var(--card); box-shadow: 0 20px 40px rgb(0 0 0 / 0.35); transform: rotate(var(--turn)); transform-origin: 50% 120%; }
      .swatch-card i { position: absolute; left: 18px; right: 18px; bottom: 18px; height: 64px; border-radius: 14px; background: var(--accent); }
      .type-card { position: absolute; right: 4%; top: 0; display: grid; place-items: center; width: 130px; height: 130px; border-radius: 50%; background: #fff584; color: #57083b; font: 700 48px/1 "Unbounded", sans-serif; }

      .browser { overflow: hidden; border-radius: 18px; background: #ffffff; box-shadow: 0 30px 60px rgb(43 18 48 / 0.35); transform: rotate(-3deg); }
      .browser__bar { display: flex; gap: 7px; padding: 12px 14px; background: #eceae7; }
      .browser__bar i { width: 11px; height: 11px; border-radius: 50%; background: #c9c4be; }
      .browser__screen { position: relative; aspect-ratio: 1200 / 630; }
      .browser__screen img { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; }
      .browser__screen img + img { opacity: 0; }

      .ticks { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; font-size: clamp(18px, 1.8vw, 24px); font-weight: 600; }
      .ticks li { display: flex; align-items: center; gap: 16px; padding: 18px 22px; border-radius: 18px; background: rgb(255 255 255 / 0.1); }
      .ticks span { position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fff584; }
      .ticks span::after { content: ""; position: absolute; left: 13px; top: 8px; width: 8px; height: 15px; border: solid #175b5d; border-width: 0 3px 3px 0; transform: rotate(45deg); }

      [data-motion] :is([data-rise], .h1-line > span, [data-bubble], [data-swatch], [data-tick]) { opacity: 0; }

      @media (max-width: 900px) {
        .panel { border-radius: 28px 28px 0 0; }
        .panel__inner { grid-template-columns: 1fr; gap: 40px; padding-block: 96px 56px; }
        .chat { margin-left: 0; }
        .brandkit { height: 300px; }
        .swatch-card { width: 130px; height: 210px; margin-left: -65px; }
        .type-card { width: 96px; height: 96px; font-size: 36px; }
      }

      @media (max-width: 1000px) { .gets { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 640px) {
        .gets { grid-template-columns: 1fr; }
        .talk { display: none; }
        .section { padding-block: 80px; }
        .final { margin-inline: 12px; padding: 72px 20px; border-radius: 28px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-cue::after { animation: none; transform: none; }
        .btn, .btn span, .get::before { transition: none; }
      }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={PORTFOLIO_URL}>Łukasz Moszczyński<span> /</span> próbki</a>
        <div class="top-actions">
          <a class="talk" href={CONTACT_URL}>Porozmawiajmy</a>
          <SamplesMenu variant="top" />
        </div>
      </div>
    </header>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="grid-lines" aria-hidden="true"></div>
        <div class="orbs" aria-hidden="true">
          {samples.map((sample, index) => <span class="orb" style={`--orb:${sample.colours.primary};left:${[8, 55, 30, 70, 0][index % 5]}%;top:${[5, 0, 45, 50, 60][index % 5]}%`} data-orb></span>)}
        </div>
        <div class="wrap">
          <p class="kicker" data-rise>Przykładowe strony · {samples.length} realizacji</p>
          <h1 id="hero-title"><span class="h1-line"><span>Strony,</span></span><span class="h1-line"><span>które sprzedają</span></span><span class="h1-line"><span>charakter<span class="dot">.</span></span></span></h1>
          <p class="lead" data-rise>Każda próbka powstała pod prawdziwy brief: własny wygląd, komponenty i animacje, a pod spodem jeden design system i dostępność sprawdzana automatycznie. Wybierz którąś i zobacz, jak zachowuje się na żywo.</p>
          <div class="actions" data-rise>
            <a class="btn btn--accent" href="#probki">Zobacz próbki <span aria-hidden="true">↓</span></a>
            <a class="btn btn--ghost" href={CONTACT_URL}>Zamów swoją <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <span class="scroll-cue" aria-hidden="true"></span>
      </section>

      <section class="journey" aria-labelledby="journey-title">
        <h2 class="visually-hidden" id="journey-title">Droga do marki, którą rozpoznaje cała branża</h2>

        <article class="panel panel--rose">
          <div class="wrap panel__inner" data-panel>
            <div class="panel__copy">
              <p class="panel__step">01 · Rozmowa</p>
              <h3 class="panel__title">Rozmawiamy o Twojej firmie.</h3>
              <p class="panel__text">Kim jesteś, dla kogo pracujesz i co Cię wyróżnia. Wystarczy krótki opis albo link do obecnej strony. Pytamy o to, czego nie widać w ofercie.</p>
            </div>
            <div class="panel__visual" aria-hidden="true">
              <div class="chat">
                <span class="bubble bubble--in" data-bubble>Robimy meble na wymiar od 1998 roku.</span>
                <span class="bubble bubble--out" data-bubble>A co mówią klienci, kiedy je odbierają?</span>
                <span class="bubble bubble--in" data-bubble>„Pachnie jak u dziadka w warsztacie.”</span>
                <span class="bubble bubble--out" data-bubble>To jest Wasza marka. Zaczynamy od tego.</span>
              </div>
            </div>
          </div>
        </article>

        <article class="panel panel--plum">
          <div class="wrap panel__inner" data-panel>
            <div class="panel__copy">
              <p class="panel__step">02 · Branding</p>
              <h3 class="panel__title">Projektujemy Twoją markę.</h3>
              <p class="panel__text">Logo, kolory, typografia i ton głosu, które pasują do tego, kim jesteś dziś.</p>
            </div>
            <div class="panel__visual" aria-hidden="true">
              <div class="brandkit">
                {samples.slice(0, 5).map((sample, index) => <span class="swatch-card" style={`--card:${sample.colours.primary};--accent:${sample.colours.accent};--turn:${(index - 2) * 9}deg`} data-swatch><i></i></span>)}
                <span class="type-card" data-swatch>Aa</span>
              </div>
            </div>
          </div>
        </article>

        <article class="panel panel--lemon">
          <div class="wrap panel__inner" data-panel>
            <div class="panel__copy">
              <p class="panel__step">03 · Strona</p>
              <h3 class="panel__title">Programujemy stronę, która się rusza.</h3>
              <p class="panel__text">Marka zamienia się w stronę: własne komponenty, animacje, które pokazują, jak działa oferta, i dostępność sprawdzana przy każdej zmianie. Tak, jak w próbkach poniżej.</p>
            </div>
            <div class="panel__visual" aria-hidden="true">
              <div class="browser">
                <div class="browser__bar"><i></i><i></i><i></i></div>
                <div class="browser__screen">
                  {samples.filter((sample) => sample.preview).map((sample) => <img src={sample.preview} alt="" width="1200" height="630" loading="lazy" data-screen />)}
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="panel panel--teal">
          <div class="wrap panel__inner" data-panel>
            <div class="panel__copy">
              <p class="panel__step">04 · Start</p>
              <h3 class="panel__title">Strona rusza, a Ty edytujesz ją sam.</h3>
              <p class="panel__text">Wdrażamy, uczymy edycji treści i zostajemy pod telefonem. Sklep, blog czy rezerwacje: zaplecze dobieramy do tego, jak pracujesz.</p>
            </div>
            <div class="panel__visual" aria-hidden="true">
              <ul class="ticks" role="list">
                <li data-tick><span></span>Działa na telefonie i komputerze</li>
                <li data-tick><span></span>Dostępna (WCAG 2.2 AA)</li>
                <li data-tick><span></span>Treści edytujesz bez programisty</li>
                <li data-tick><span></span>Gotowa pod Google i AI</li>
              </ul>
            </div>
          </div>
        </article>

        <article class="panel panel--orange">
          <div class="wrap panel__inner panel__inner--final" data-panel>
            <p class="panel__step">05 · Efekt</p>
            <h3 class="panel__title panel__title--big">Marka, którą rozpoznaje cała branża.</h3>
            <p class="panel__text">Spójne logo, strona i teksty mówią jednym głosem. Klient pamięta Cię po jednym spojrzeniu i wie, po co ma zadzwonić.</p>
            <div class="actions"><a class="btn btn--dark" href={CONTACT_URL}>Zacznijmy od rozmowy <span aria-hidden="true">→</span></a><a class="btn btn--line" href="#probki">Zobacz próbki <span aria-hidden="true">↓</span></a></div>
          </div>
        </article>
      </section>

      <section class="section" id="probki" aria-labelledby="samples-title">
        <div class="wrap">
          <div class="section-head" data-rise>
            <h2 id="samples-title">Wybierz próbkę</h2>
            <p>Najedź na nazwę, żeby zobaczyć podgląd. Kliknij, żeby otworzyć stronę na żywo, z animacjami i działającymi formularzami (demo).</p>
          </div>
          <SampleRows samples={samples} size="page" />
        </div>
      </section>

      <section class="section" aria-labelledby="gets-title">
        <div class="wrap">
          <div class="section-head" data-rise>
            <h2 id="gets-title">Co dostajesz</h2>
            <p>To, co widzisz w próbkach, trafia do Twojej strony: od pierwszego szkicu po wdrożenie.</p>
          </div>
          <ul class="gets" role="list">
            {gets.map((item, index) => (
              <li class="get" data-rise>
                <span class="get-num">{String(index + 1).padStart(2, '0')}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="final" aria-labelledby="final-title">
        <span class="final-ring" aria-hidden="true" data-ring></span>
        <span class="final-ring final-ring--2" aria-hidden="true" data-ring></span>
        <h2 id="final-title" data-rise>Twoja strona może być następną próbką.</h2>
        <p data-rise>Wyślij krótki opis firmy albo link do obecnej strony. Przygotuję pomysł na wygląd i zakres.</p>
        <a class="btn" href={CONTACT_URL} data-rise>Porozmawiajmy <span aria-hidden="true">→</span></a>
      </section>
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>Przykładowe treści i grafiki; w gotowej stronie zastępują je materiały klienta.</p>
        <p><a href={PORTFOLIO_URL}>Portfolio</a></p>
      </div>
    </footer>
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);
      document.documentElement.setAttribute('data-motion-ready', '');
      // A panel taller than the screen (phones) sticks once its bottom edge reaches the screen's bottom edge.
      const stickPanels = () => document.querySelectorAll('.panel').forEach((panel) => panel.style.setProperty('--stick', `${Math.min(0, window.innerHeight - panel.offsetHeight)}px`));
      stickPanels();
      ScrollTrigger.addEventListener('refreshInit', stickPanels);
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Hero: the lines rise from their masks, the rest follows; the sample-coloured orbs travel behind.
        gsap.timeline({ defaults: { ease: 'power4.out' } })
          .fromTo('.h1-line > span', { yPercent: 110, opacity: 1 }, { yPercent: 0, opacity: 1, duration: 1.2, stagger: 0.12 }, 0.1)
          .fromTo('.hero [data-rise]', { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 1, stagger: 0.1 }, 0.5);
        document.querySelectorAll('[data-orb]').forEach((orb) => {
          const travel = () => gsap.to(orb, { xPercent: gsap.utils.random(-60, 60), yPercent: gsap.utils.random(-50, 50), scale: gsap.utils.random(0.7, 1.3), duration: gsap.utils.random(10, 16), ease: 'sine.inOut', onComplete: travel });
          travel();
        });
        gsap.to('.hero .wrap', { yPercent: -12, opacity: 0.4, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'center center', end: 'bottom top', scrub: true } });
        // Everything else rises in as it arrives; the rows slide in from the left one by one.
        ScrollTrigger.batch('main > .section [data-rise], .final [data-rise]', { start: 'top 88%', once: true, onEnter: (items) => gsap.fromTo(items, { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 1, stagger: 0.1, ease: 'power3.out' }) });
        gsap.fromTo('#probki .sm-row', { x: -60, opacity: 0 }, { x: 0, opacity: 1, duration: 1, stagger: 0.1, ease: 'power3.out', scrollTrigger: { trigger: '#probki .sm-rows', start: 'top 85%', once: true } });
        gsap.to('[data-ring]', { rotation: 360, duration: 50, ease: 'none', repeat: -1 });
        // Journey: as each panel slides over the one before, the one beneath sinks back and dims (every width);
        // each panel plays its own small scene once when it arrives.
        const panels = gsap.utils.toArray('.panel');
        panels.slice(0, -1).forEach((panel, index) => {
          gsap.to(panel.querySelector('[data-panel]'), { scale: 0.9, opacity: 0.35, ease: 'none', scrollTrigger: { trigger: panels[index + 1], start: 'top bottom', end: 'top top', scrub: true } });
        });
        const scene = (panel, play) => ScrollTrigger.create({ trigger: panel, start: 'top 55%', once: true, onEnter: play });
        scene(panels[0], () => gsap.fromTo('[data-bubble]', { y: 30, opacity: 0, scale: 0.9 }, { y: 0, opacity: 1, scale: 1, duration: 0.7, stagger: 0.5, ease: 'power3.out' }));
        scene(panels[1], () => gsap.fromTo('[data-swatch]', { y: 160, rotation: 0, opacity: 0 }, { y: 0, rotation: (index, card) => card.style.getPropertyValue('--turn') || 0, opacity: 1, duration: 1.1, stagger: 0.12, ease: 'power3.out' }));
        scene(panels[3], () => gsap.fromTo('[data-tick]', { x: 60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.8, stagger: 0.25, ease: 'power3.out' }));
        const screens = gsap.utils.toArray('[data-screen]');
        if (screens.length > 1) {
          const cycle = gsap.timeline({ repeat: -1, paused: true });
          screens.forEach((screen, index) => {
            const next = screens[(index + 1) % screens.length];
            cycle.set(next, { zIndex: 2 }, '+=1.6').to(next, { opacity: 1, duration: 0.8, ease: 'power2.inOut' }).set(screen, { opacity: 0, zIndex: 1 }).set(next, { zIndex: 1 });
          });
          ScrollTrigger.create({ trigger: panels[2], start: 'top bottom', end: 'bottom top', onToggle: (self) => (self.isActive ? cycle.play() : cycle.pause()) });
          gsap.fromTo('.browser', { y: 120, rotation: 6 }, { y: 0, rotation: -3, ease: 'none', scrollTrigger: { trigger: panels[2], start: 'top bottom', end: 'top top', scrub: true } });
        }
      }
    </script>
  </body>
</html>
