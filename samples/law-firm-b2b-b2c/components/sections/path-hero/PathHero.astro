---
// Path hero. title words are split so they can rise in one by one; accent = the words set in italic green.
// Each door has data-path-set: it sets the path (law.js) and its href leads to the offer.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
interface Door { path: 'firmy' | 'klienci'; for: string; title: string; items: string[]; go: string }
interface Props { label: string; title: string; accent: string; lead: string; doors: Door[]; seal: string }
const { label, title, accent, lead, doors, seal } = Astro.props;
const accentWords = new Set(accent.split(' '));
const words = title.split(' ');
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>';
---
<section class="ds-path-hero" aria-labelledby="hero-title">
  <div class="ds-container">
    <div class="ds-path-hero__top">
      <div>
        <div data-hero-fade><Eyebrow text={label} /></div>
        <h1 class="ds-path-hero__title" id="hero-title">
          {words.map((word, index) => (
            <>
              <span class="ds-path-hero__word" data-hero-word>{accentWords.has(word) ? <em>{word}</em> : word}</span>{index < words.length - 1 ? ' ' : ''}
            </>
          ))}
        </h1>
        <p class="ds-path-hero__lead" data-hero-fade>{lead}</p>
      </div>
      <svg class="ds-path-hero__seal" viewBox="0 0 160 160" aria-hidden="true">
        <defs><path id="seal-circle" d="M80 80 m-62 0 a62 62 0 1 1 124 0 a62 62 0 1 1 -124 0" /></defs>
        <g class="ds-path-hero__seal-ring" data-seal-ring>
          <text font-size="11" letter-spacing="3" fill="currentColor"><textPath href="#seal-circle">{seal}</textPath></text>
        </g>
        <circle cx="80" cy="80" r="44" fill="none" stroke="currentColor" stroke-width="1" />
        <text x="80" y="104" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size="68" fill="none" stroke="currentColor" stroke-width="1.6" data-seal-sign>§</text>
      </svg>
    </div>
    <div class="ds-path-hero__doors">
      {doors.map((door, index) => (
        <a class={`ds-door${index === 1 ? ' ds-door--ink' : ''}`} href="#oferta" data-path-set={door.path} data-hero-door>
          <span class="ds-door__for">{door.for}</span>
          <h2 class="ds-door__title">{door.title}</h2>
          <ul class="ds-door__items" role="list">{door.items.map((item) => <li class="ds-door__item">{item}</li>)}</ul>
          <span class="ds-door__go">{door.go}<Fragment set:html={arrow} /></span>
        </a>
      ))}
    </div>
  </div>
</section>
