---
// Law FAQ with FAQPage structured data (the same questions and answers as on the page).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
interface Props { id?: string; number: string; label: string; title: string; lead: string; items: { question: string; answer: string }[] }
const { id = 'faq', number, label, title, lead, items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
};
---
<section class="ds-section ds-section--rule ds-law-faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container ds-law-faq__grid">
    <div class="ds-section-head" data-reveal>
      <Eyebrow number={number} text={label} />
      <h2 class="ds-section-head__title" id={`${id}-title`}><Fragment set:html={title} /></h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <div data-reveal>
      {items.map((item) => (
        <details class="ds-law-faq__item" data-faq-item>
          <summary class="ds-law-faq__question">{item.question}<span class="ds-law-faq__icon" aria-hidden="true"></span></summary>
          <div class="ds-law-faq__panel" data-faq-panel><p class="ds-law-faq__answer">{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
