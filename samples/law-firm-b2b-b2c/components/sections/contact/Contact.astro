---
// Contact. path presets the choice (audience pages); the facts beside the form follow the chosen option (law.js).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import InkButton from '../../atoms/ink-button/InkButton.astro';
import { AUDIENCES } from '../../../data/offer.js';
interface Props { number: string; label: string; title: string; lead: string; path?: 'firmy' | 'klienci' }
const { number, label, title, lead, path = 'firmy' } = Astro.props;
const options = [
  { value: 'firmy', title: 'Firmy', text: 'Umowy, spory, obsługa stała' },
  { value: 'klienci', title: 'Sprawy prywatnej', text: 'Rodzina, spadki, nieruchomości' },
];
---
<section class="ds-section ds-contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="ds-container ds-contact__grid">
    <div data-reveal>
      <div class="ds-section-head">
        <Eyebrow number={number} text={label} />
        <h2 class="ds-section-head__title" id="kontakt-title"><Fragment set:html={title} /></h2>
        <p class="ds-section-head__lead">{lead}</p>
      </div>
      <ul class="ds-contact__facts" role="list">
        {Object.entries(AUDIENCES).map(([key, audience]) => (
          <li data-contact-fact={key} hidden={key !== path}>
            <span class="ds-contact__fact-label">{audience.label}</span>
            <span class="ds-contact__fact-value">{audience.box.contact}</span>
          </li>
        ))}
        <li>
          <span class="ds-contact__fact-label">Biuro</span>
          <span class="ds-contact__fact-value">ul. Przykładowa 5, Warszawa</span>
        </li>
      </ul>
    </div>
    <form class="ds-contact__form" data-contact-form data-reveal>
      <fieldset class="ds-contact__choice">
        <legend>Twoja sprawa dotyczy</legend>
        {options.map((option) => (
          <label class="ds-contact__option">
            <input type="radio" name="path" value={option.value} checked={option.value === path} data-contact-choice />
            <span class="ds-contact__option-title">{option.title}</span>
            <span class="ds-contact__option-text">{option.text}</span>
          </label>
        ))}
      </fieldset>
      <div class="ds-contact__field">
        <label class="ds-contact__label" for="contact-name">Imię i nazwisko</label>
        <input class="ds-contact__input" id="contact-name" name="name" autocomplete="name" required />
      </div>
      <div class="ds-contact__field">
        <label class="ds-contact__label" for="contact-phone">Telefon</label>
        <input class="ds-contact__input" id="contact-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="ds-contact__field ds-contact__field--wide">
        <label class="ds-contact__label" for="contact-email">E-mail</label>
        <input class="ds-contact__input" id="contact-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="ds-contact__field ds-contact__field--wide">
        <label class="ds-contact__label" for="contact-message">W czym możemy pomóc?</label>
        <textarea class="ds-contact__input" id="contact-message" name="message" rows="4"></textarea>
      </div>
      <label class="ds-contact__consent">
        <input type="checkbox" name="consent" required />
        <span>Wyrażam zgodę na kontakt w sprawie mojego zapytania. Administratorem danych jest kancelaria.</span>
      </label>
      <div class="ds-contact__send"><InkButton text="Wyślij zapytanie" type="submit" /></div>
      <p class="ds-contact__thanks" role="status" hidden data-contact-thanks>Dziękujemy. To przykładowy formularz: w gotowej stronie wiadomość trafi do właściwego zespołu.</p>
    </form>
  </div>
</section>
