---
interface Props { index: number; name: string; line: string; href: string }
const { index, name, line, href } = Astro.props;
---
<a class="ds-service-row" href={href} data-service-row>
  <span class="ds-service-row__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <span class="ds-service-row__text"><span class="ds-service-row__name">{name}</span><span class="ds-service-row__line">{line}</span></span>
  <svg class="ds-service-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
</a>
