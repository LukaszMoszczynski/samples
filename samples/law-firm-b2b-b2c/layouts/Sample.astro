---
// Page shell for this sample: tokens, the client look, base styles, noindex. Component CSS is imported by each page.
import '../ds/tokens/shared.css';
import '../brand.css';
import '../ds/components/base/base.css';

interface Props {
  lang: 'pl' | 'en';
  title: string;
  description?: string;
  fonts?: string;
}
const { lang, title, description = '', fonts = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
  </head>
  <body>
    <slot />
  </body>
</html>
