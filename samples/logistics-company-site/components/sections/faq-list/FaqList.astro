---
import MonoLabel from '../../atoms/mono-label/MonoLabel.astro';
interface Props { id: string; label: string; title: string; lead: string; items: { question: string; answer: string }[] }
const { id, label, title, lead, items } = Astro.props;
---
<section class="ds-section ds-faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container ds-faq__grid">
    <div class="ds-section-head" data-reveal>
      <MonoLabel text={label} />
      <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <div data-reveal>
      {items.map((item) => (
        <details class="ds-faq__item">
          <summary class="ds-faq__question">{item.question}<span class="ds-faq__plus" aria-hidden="true"></span></summary>
          <p class="ds-faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
