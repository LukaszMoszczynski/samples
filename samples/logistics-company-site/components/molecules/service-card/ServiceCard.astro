---
// Service card. icon: truck | warehouse | cold | customs.
interface Props { index: string; icon: 'truck' | 'warehouse' | 'cold' | 'customs'; title: string; text: string; href: string }
const { index, icon, title, text, href } = Astro.props;
const icons = {
  truck: '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>',
  warehouse: '<path d="M3 10 12 4l9 6v10H3z"/><path d="M7 20v-6h10v6M7 17h10"/>',
  cold: '<path d="M12 3v18M4.5 7.5l15 9M19.5 7.5l-15 9"/><path d="m9 4 3 2 3-2M9 20l3-2 3 2"/>',
  customs: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4M9 12h7M9 16h5"/>',
};
---
<a class="ds-service-card" href={href} data-reveal>
  <span class="ds-service-card__top">
    <span class="ds-service-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icons[icon]} /></svg></span>
    <span class="ds-service-card__index">{index}</span>
  </span>
  <h3 class="ds-service-card__title">{title}</h3>
  <p class="ds-service-card__text">{text}</p>
  <span class="ds-service-card__more">Więcej o usłudze →</span>
</a>
