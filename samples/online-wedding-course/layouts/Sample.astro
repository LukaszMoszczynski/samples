---
// Page shell for this sample: tokens, the client look, base styles, noindex, link preview and tab icon.
// Component CSS is imported by each page. assets/og.jpg (made by scripts/make-og.mjs), assets/favicon.svg and
// assets/apple-touch-icon.png are picked up when they exist.
import '../ds/tokens/shared.css';
import '../brand.css';
import '../ds/components/base/base.css';

interface Props {
  lang: 'pl' | 'en';
  title: string;
  description?: string;
  fonts?: string;
}
const { lang, title, description = '', fonts = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap' } = Astro.props;
const assets = import.meta.glob<string>('../assets/{og.jpg,favicon.svg,apple-touch-icon.png}', { eager: true, query: '?url', import: 'default' });
const og = assets['../assets/og.jpg'];
const favicon = assets['../assets/favicon.svg'];
const touchIcon = assets['../assets/apple-touch-icon.png'];
const site = Astro.site ?? new URL('https://lukaszmoszczynski.github.io');
const pageUrl = new URL(Astro.url.pathname, site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <!-- A reload starts at the top; runs before the browser restores the old scroll position. -->
    <script is:inline>if ("scrollRestoration" in history) history.scrollRestoration = "manual"; if (!location.hash) { window.scrollTo(0, 0); addEventListener("load", function () { window.scrollTo(0, 0); }); }</script>
    <!-- Elements that animate in start hidden from the first paint (no flash); shown anyway if the script never runs. -->
    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) { var root = document.documentElement; root.setAttribute("data-motion", ""); setTimeout(function () { if (!root.hasAttribute("data-motion-ready")) root.removeAttribute("data-motion"); }, 4000); }</script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_GB'} />
    {og && <meta property="og:image" content={new URL(og, site).href} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    {og && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    {favicon && <link rel="icon" type="image/svg+xml" href={favicon} />}
    {touchIcon && <link rel="apple-touch-icon" href={touchIcon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
  </head>
  <body>
    <slot />
  </body>
</html>
