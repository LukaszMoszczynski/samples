---
// Course footer on deep plum: wordmark and motto, link columns, the sample note.
import Wordmark from '../../molecules/wordmark/Wordmark.astro';
interface Props { motto: string; columns: { title: string; links: { text: string; href: string }[] }[] }
const { motto, columns } = Astro.props;
---
<footer class="ds-plan-footer">
  <div class="ds-container ds-plan-footer__grid">
    <div class="ds-plan-footer__brand">
      <Wordmark light />
      <p class="ds-plan-footer__motto">{motto}</p>
    </div>
    {columns.map((column) => (
      <nav class="ds-plan-footer__column" aria-label={column.title}>
        <p class="ds-plan-footer__title">{column.title}</p>
        <ul role="list">{column.links.map((link) => <li><a href={link.href}>{link.text}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="ds-container ds-plan-footer__legal">
    <p>Przykładowa strona przygotowana jako propozycja. Ceny, liczby i opinie są przykładowe.</p>
  </div>
</footer>
