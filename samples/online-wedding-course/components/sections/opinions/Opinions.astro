---
// Couples about the course: a deck of cards (white, a gold inner frame, a plum seal with the P·L·A·N heart). plan.js
// turns the column into a deck: drag the top card aside, Previous / Next, or the arrow keys. Without JS the cards sit in
// a column. The quotes are examples, marked as such.
import Overline from '../../atoms/overline/Overline.astro';
import Heart from '../../atoms/heart/Heart.astro';
import PillButton from '../../atoms/pill-button/PillButton.astro';
import Divider from '../../molecules/divider/Divider.astro';
interface Props { label: string; title: string; accent: string; hint: string; note: string; items: { quote: string; who: string }[] }
const { label, title, accent, hint, note, items } = Astro.props;
---
<section class="ds-section ds-section--blush ds-opinions" id="opinie" aria-labelledby="opinie-title" data-opinions>
  <div class="ds-container ds-opinions__grid">
    <div data-reveal>
      <div class="ds-section-head">
        <Overline text={label} />
        <h2 class="ds-section-head__title" id="opinie-title">{title} <span class="ds-accent">{accent}</span></h2>
        <Divider />
        <p class="ds-opinions__hint">{hint}</p>
      </div>
      <div class="ds-opinions__controls">
        <PillButton text="← Poprzednia" variant="outline" icon="none" data={{ 'data-opinion-prev': '' }} />
        <PillButton text="Następna" data={{ 'data-opinion-next': '' }} />
      </div>
      <p class="ds-demo-note">{note}</p>
      <p class="ds-visually-hidden" aria-live="polite" data-opinion-announce></p>
    </div>
    <div class="ds-opinions__deck" role="group" tabindex="0" aria-label="Opinie par: strzałki zmieniają kartkę" data-opinion-deck data-reveal>
      {items.map((item) => (
        <figure class="ds-opinion" data-opinion>
          <span class="ds-opinion__seal" aria-hidden="true"><Heart variant="gold" class="ds-opinion__seal-heart" /></span>
          <blockquote class="ds-opinion__quote">{item.quote}</blockquote>
          <figcaption class="ds-opinion__who">{item.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
