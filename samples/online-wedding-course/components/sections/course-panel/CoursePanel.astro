---
// A demo of the course platform: the modules with progress on the left, one lesson's checklist on the right. Ticking
// items fills the module's heart and moves the progress (plan.js); nothing is saved.
import Overline from '../../atoms/overline/Overline.astro';
import Clover from '../../atoms/clover/Clover.astro';
interface Props { label: string; title: string; accent: string; lead: string; modules: string[]; lesson: string; tasks: string[] }
const { label, title, accent, lead, modules, lesson, tasks } = Astro.props;
---
<section class="ds-section ds-section--ecru ds-course-panel" id="panel" aria-labelledby="panel-title">
  <div class="ds-container ds-course-panel__grid">
    <div class="ds-section-head" data-reveal>
      <Overline text={label} />
      <h2 class="ds-section-head__title" id="panel-title">{title} <span class="ds-accent">{accent}</span></h2>
      <p class="ds-section-head__lead">{lead}</p>
      <p class="ds-demo-note">Podgląd platformy kursu (demo): zaznaczenia nie są zapisywane.</p>
    </div>
    <div class="ds-course-panel__window" data-reveal>
      <div class="ds-course-panel__bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="ds-course-panel__body">
        <nav class="ds-course-panel__side" aria-label="Moduły w panelu (demo)">
          <Clover class="ds-course-panel__clover" active={0} />
          <ol role="list">
            {modules.map((module, index) => <li class:list={['ds-course-panel__module', { 'ds-course-panel__module--current': index === 0 }]}><span>{index + 1}</span>{module}</li>)}
          </ol>
        </nav>
        <div class="ds-course-panel__lesson">
          <p class="ds-course-panel__crumb">Moduł 1 · Pragnienia</p>
          <h3 class="ds-course-panel__title">{lesson}</h3>
          <div class="ds-course-panel__progress">
            <span class="ds-course-panel__meter"><span class="ds-course-panel__fill" data-panel-fill></span></span>
            <span data-panel-count aria-live="polite">0 z {tasks.length} gotowe</span>
          </div>
          <ul class="ds-course-panel__tasks" role="list">
            {tasks.map((task, index) => (
              <li><label class="ds-course-panel__task"><input type="checkbox" data-panel-task /><span class="ds-course-panel__box" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10" pathLength="1000" /></svg></span><span>{task}</span></label></li>
            ))}
          </ul>
          <p class="ds-course-panel__done" data-panel-done hidden>Pierwszy krok gotowy. Wasz plan rośnie.</p>
        </div>
      </div>
    </div>
  </div>
</section>
