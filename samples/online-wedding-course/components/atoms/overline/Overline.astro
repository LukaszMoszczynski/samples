---
// Overline: the identity's small label, Libre Franklin in capitals with wide tracking, after a tiny gold heart.
interface Props { text: string; tag?: 'p' | 'span' }
const { text, tag: Tag = 'p' } = Astro.props;
---
<Tag class="ds-overline"><svg class="ds-overline__heart" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 88C20 66 6 50 6 32 6 18 17 8 30 8c9 0 16 5 20 13 4-8 11-13 20-13 13 0 24 10 24 24 0 18-14 34-44 56z" /></svg>{text}</Tag>
