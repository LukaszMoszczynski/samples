---
// Overline: the identity's small label, Libre Franklin in capitals with wide tracking, under a short gold line.
// " · " in the text becomes a micro-heart (rosewood on light, gold on plum); without it a heart leads the text.
// The first heart beats once when the label arrives (plan.js).
import Heart from '../heart/Heart.astro';
interface Props { text: string; tag?: 'p' | 'span' }
const { text, tag: Tag = 'p' } = Astro.props;
const parts = text.split(' · ');
---
<Tag class="ds-overline">
  <span class="ds-overline__line" aria-hidden="true"></span>
  <span class="ds-overline__text">
    {parts.length > 1
      ? parts.map((part, index) => <>{index > 0 && <><Heart class="ds-overline__heart" data={index === 1 ? { 'data-beat': '' } : {}} /><span class="ds-visually-hidden"> · </span></>}{part}</>)
      : <><Heart class="ds-overline__heart" data={{ 'data-beat': '' }} />{text}</>}
  </span>
</Tag>
