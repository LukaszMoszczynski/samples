const withLength = (markup: string) => markup.replace(/<(path|circle|ellipse|line|polyline)\s/g, '<$1 pathLength="1000" ');
const drawing = drawings[name];
---
<svg
  class:list={['ds-dish', extraClass]}
  viewBox={drawing.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  data-draw={draw ? '' : undefined}
  data-dish={name}
>
  {steam && drawing.steam && <g class="ds-dish__steam" data-steam set:html={withLength(drawing.steam)} />}
  <g set:html={withLength(drawing.art)} />
</svg>
