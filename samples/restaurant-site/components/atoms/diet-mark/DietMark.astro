---
// Diet mark: a short round badge (V wege, VG wegańskie, BG bez glutenu, ostre) with its full name for screen readers.
interface Props { kind: 'v' | 'vg' | 'bg' | 'hot'; long?: boolean }
const { kind, long = false } = Astro.props;
const marks = {
  v: { short: 'V', name: 'wegetariańskie' },
  vg: { short: 'VG', name: 'wegańskie' },
  bg: { short: 'BG', name: 'bez glutenu' },
  hot: { short: '', name: 'ostre' },
};
const mark = marks[kind];
---
<span class={`ds-diet-mark ds-diet-mark--${kind}`} title={mark.name}>
  <span class="ds-diet-mark__short" aria-hidden="true">{kind === 'hot'
    ? <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 3.5c-.4-1.2.3-2 1.3-2.2M10.4 4.2c2.2.6 3 2.6 2.1 4.6-1.4 3-5.4 5.4-9.6 5.6 2.6-1.6 4.4-4 5-6.6.4-1.9 1-3 2.5-3.6Z" /></svg>
    : mark.short}</span>
  {long ? <span class="ds-diet-mark__name">{mark.name}</span> : <span class="ds-visually-hidden">{mark.name}</span>}
</span>
