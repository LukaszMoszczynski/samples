---
// Gallery: a mosaic of tiles in the brand colours with drawn dishes and short captions. In the real site the tiles hold
// the restaurant's photos; the drawings stand in for them. Each drawing draws itself as its tile comes into view.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import DishDrawing from '../../molecules/dish-drawing/DishDrawing.astro';
type Drawing = 'pasta' | 'soup' | 'fish' | 'salad' | 'tart' | 'bread' | 'wine' | 'coffee';
interface Props {
  id: string; eyebrow: string; title: string; lead: string;
  tiles: { drawing: Drawing; caption: string; tone: 'tomato' | 'ink' | 'cream' | 'basil' | 'blush'; size?: 'wide' | 'tall' }[];
}
const { id, eyebrow, title, lead, tiles } = Astro.props;
---
<section class="ds-section ds-gallery" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Eyebrow text={eyebrow} />
      <h2 class="ds-section-head__title" id={`${id}-title`} set:html={title} />
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <ul class="ds-gallery__grid" role="list">
      {tiles.map((tile) => (
        <li class:list={['ds-gallery__cell', tile.size && `ds-gallery__cell--${tile.size}`]} data-reveal>
          <figure class={`ds-gallery__tile ds-gallery__tile--${tile.tone}`}>
            <DishDrawing name={tile.drawing} class="ds-gallery__dish" />
            <figcaption class="ds-gallery__caption">{tile.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
