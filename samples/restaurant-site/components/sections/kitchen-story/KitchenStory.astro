---
// Kitchen story: a large line drawing (cutting board, bread, tomatoes, herbs) that draws itself once as it comes into
// view, next to where the produce comes from and the four seasons of the menu (the current one marked).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import DishDrawing from '../../molecules/dish-drawing/DishDrawing.astro';
interface Props {
  id: string; eyebrow: string; title: string; lead: string; points: string[];
  seasons: { name: string; produce: string; current?: boolean }[];
}
const { id, eyebrow, title, lead, points, seasons } = Astro.props;
---
<section class="ds-section ds-section--paper ds-kitchen" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container ds-kitchen__grid">
    <figure class="ds-kitchen__art" data-kitchen-art>
      <DishDrawing name="board" label="Rysunek: deska z chlebem na zakwasie, pomidorami, czosnkiem, bazylią i nożem" />
      <figcaption class="ds-kitchen__caption">Rano na desce, wieczorem na talerzu.</figcaption>
    </figure>
    <div class="ds-kitchen__copy">
      <div class="ds-section-head" data-reveal>
        <Eyebrow text={eyebrow} />
        <h2 class="ds-section-head__title" id={`${id}-title`} set:html={title} />
        <p class="ds-section-head__lead">{lead}</p>
      </div>
      <ul class="ds-kitchen__points" role="list">
        {points.map((point) => (
          <li class="ds-kitchen__point" data-reveal>
            <svg class="ds-kitchen__tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13c2 1.5 3.6 3.4 5 5.4C11.8 12.6 15.6 8 20.4 4.6" /></svg>
            {point}
          </li>
        ))}
      </ul>
      <ul class="ds-kitchen__seasons" role="list" aria-label="Karta w porach roku" data-reveal>
        {seasons.map((season) => (
          <li class:list={['ds-kitchen__season', { 'is-current': season.current }]} aria-current={season.current ? 'true' : undefined}>
            <span class="ds-kitchen__season-name">{season.name}{season.current && <span class="ds-kitchen__now"> · teraz</span>}</span>
            <span class="ds-kitchen__season-produce">{season.produce}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
