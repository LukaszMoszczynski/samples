---
// How I work: four steps on a track. When the section arrives the track draws once and a ball rolls along it,
// filling each step's circle as it passes (site.js). Phones: the track runs down the left.
import Label from '../../atoms/label/Label.astro';
import Ball from '../../atoms/ball/Ball.astro';
import Orbs from '../../organisms/orbs/Orbs.astro';
interface Props { label: string; title: string; accent: string; lead: string; steps: { name: string; time: string; text: string }[] }
const { label, title, accent, lead, steps } = Astro.props;
---
<section class="ds-section ds-process" id="jak-pracuje" aria-labelledby="process-title">
  <Orbs tone="light" />
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Label text={label} />
      <h2 class="ds-section-head__title" id="process-title">{title} <span class="ds-accent">{accent}</span></h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <div class="ds-process__board" data-process>
      <span class="ds-process__track" aria-hidden="true"><span class="ds-process__track-fill" data-process-fill></span></span>
      <Ball color="rose" class="ds-process__roller" />
      <ol class="ds-process__steps" role="list">
        {steps.map((step, index) => (
          <li class="ds-process__step" data-process-step>
            <span class="ds-process__dot" aria-hidden="true">{index + 1}</span>
            <p class="ds-process__time">{step.time}</p>
            <h3 class="ds-process__name">{step.name}</h3>
            <p class="ds-process__text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
