---
// Claim makeovers: "Było" gets a rose line through it, "Jest" rises in underneath (site.js, once per card).
// Examples written for the sample, marked as such.
import Label from '../../atoms/label/Label.astro';
import Ball from '../../atoms/ball/Ball.astro';
import Orbs from '../../organisms/orbs/Orbs.astro';
interface Props { label: string; title: string; accent: string; lead: string; note: string; items: { trade: string; before: string; after: string; colour: 'rose' | 'plum' | 'lemon' }[] }
const { label, title, accent, lead, note, items } = Astro.props;
---
<section class="ds-section ds-section--rose ds-cases" id="realizacje" aria-labelledby="cases-title">
  <Orbs tone="rose" />
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Label text={label} />
      <h2 class="ds-section-head__title" id="cases-title">{title} <span class="ds-accent">{accent}</span></h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <ul class="ds-cases__list" role="list">
      {items.map((item) => (
        <li class="ds-cases__card" data-case data-reveal>
          <Ball color={item.colour} class="ds-cases__ball" />
          <p class="ds-cases__trade">{item.trade}</p>
          <p class="ds-cases__before"><span class="ds-cases__tag">Było</span> <span class="ds-strike" data-strike>„{item.before}”</span></p>
          <p class="ds-cases__after" data-case-after><span class="ds-cases__tag ds-cases__tag--after">Jest</span> „{item.after}”</p>
        </li>
      ))}
    </ul>
    <p class="ds-demo-note">{note}</p>
  </div>
</section>
