---
// Client voices: three short quotes; examples, marked as such.
import Label from '../../atoms/label/Label.astro';
import Orbs from '../../organisms/orbs/Orbs.astro';
interface Props { label: string; title: string; accent: string; note: string; items: { quote: string; who: string }[] }
const { label, title, accent, note, items } = Astro.props;
---
<section class="ds-section ds-section--blush ds-voices" id="opinie" aria-labelledby="voices-title">
  <Orbs tone="light" />
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Label text={label} />
      <h2 class="ds-section-head__title" id="voices-title">{title} <span class="ds-accent">{accent}</span></h2>
    </div>
    <ul class="ds-voices__list" role="list">
      {items.map((item) => (
        <li class="ds-voices__item" data-reveal>
          <figure>
            <blockquote><p>„{item.quote}”</p></blockquote>
            <figcaption>{item.who}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="ds-demo-note">{note}</p>
  </div>
</section>
