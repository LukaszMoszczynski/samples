---
// Footer on the deepest plum: light logo, motto, link columns, the demo note.
import Logo from '../../molecules/logo/Logo.astro';
interface Props { motto: string; columns: { title: string; links: { text: string; href: string }[] }[] }
const { motto, columns } = Astro.props;
---
<footer class="ds-site-footer">
  <div class="ds-container ds-site-footer__grid">
    <div class="ds-site-footer__brand">
      <Logo variant="light" />
      <p class="ds-site-footer__motto">{motto}</p>
    </div>
    {columns.map((column) => (
      <nav class="ds-site-footer__column" aria-label={column.title}>
        <p class="ds-site-footer__title">{column.title}</p>
        <ul role="list">{column.links.map((link) => <li><a href={link.href}>{link.text}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="ds-container ds-site-footer__base">
    <p>© 2026 oh!design · Branding i strony dla dojrzałych marek</p>
    <p>Przykładowa strona: formularz i audyt to demo, nic nie jest wysyłane.</p>
  </div>
</footer>
