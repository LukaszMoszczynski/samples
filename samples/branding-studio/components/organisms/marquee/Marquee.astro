---
// Marquee band: the brand's lines in big Unbounded type with balls between them. site.js runs it endlessly, faster
// and slanted with the scroll speed, and turns it with the scroll direction. Decorative (the words are on the page).
interface Props { items: string[]; tone?: 'lemon' | 'rose' | 'plum'; reverse?: boolean }
const { items, tone = 'lemon', reverse = false } = Astro.props;
const run = [...items, ...items];
---
<div class:list={['ds-marquee', `ds-marquee--${tone}`]} aria-hidden="true" data-marquee data-marquee-reverse={reverse ? '' : undefined}>
  <div class="ds-marquee__track" data-marquee-track>
    {[0, 1].map(() => (
      <div class="ds-marquee__group">
        {run.map((item) => <span class="ds-marquee__item">{item}<span class="ds-marquee__ball"></span></span>)}
      </div>
    ))}
  </div>
</div>
