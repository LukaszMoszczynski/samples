---
// Process ruler: the steps of cooperation along a dimension line, like a measured drawing. The line draws once on
// enter, the numbered nodes pop and the steps rise in (osiedle.js).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
interface Props { id: string; label: string; title: string; lead: string; steps: { title: string; text: string; time: string }[] }
const { id, label, title, lead, steps } = Astro.props;
---
<section class="ds-section ds-section--grid ds-process" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Eyebrow text={label} />
      <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <div class="ds-process__track" data-process>
      <span class="ds-process__line" aria-hidden="true" data-process-line></span>
      <ol class="ds-process__list" role="list">
        {steps.map((step, index) => (
          <li class="ds-process__step">
            <span class="ds-process__node" aria-hidden="true" data-process-node>{String(index + 1).padStart(2, '0')}</span>
            <div class="ds-process__body" data-process-step>
              <span class="ds-process__time">{step.time}</span>
              <h3 class="ds-process__title"><span class="ds-visually-hidden">Krok {index + 1}: </span>{step.title}</h3>
              <p class="ds-process__text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
