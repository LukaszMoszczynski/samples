---
// Services: section heading, a grid of service cards and a closing card that leads to the estimator.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import Button from '../../atoms/button/Button.astro';
import ServiceCard from '../../molecules/service-card/ServiceCard.astro';
interface Service { icon: 'stairs' | 'windows' | 'green' | 'snow' | 'bins' | 'repair' | 'spray'; title: string; text: string; points: string[] }
interface Props { id: string; label: string; title: string; lead: string; items: Service[]; closing: { title: string; text: string; cta: { text: string; href: string } } }
const { id, label, title, lead, items, closing } = Astro.props;
---
<section class="ds-section ds-services" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Eyebrow text={label} />
      <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <ul class="ds-services__list" role="list">
      {items.map((item, index) => (
        <li data-reveal><ServiceCard index={String(index + 1).padStart(2, '0')} icon={item.icon} title={item.title} text={item.text} points={item.points} /></li>
      ))}
      <li data-reveal>
        <div class="ds-services__closing">
          <h3 class="ds-services__closing-title">{closing.title}</h3>
          <p class="ds-services__closing-text">{closing.text}</p>
          <Button text={closing.cta.text} href={closing.cta.href} variant="lime" />
        </div>
      </li>
    </ul>
  </div>
</section>
