---
// References: three example quotes from managers and a strip of what stands behind them (insurance, contracts).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import ReferenceCard from '../../molecules/reference-card/ReferenceCard.astro';
interface Props { id: string; label: string; title: string; lead: string; items: { quote: string; who: string; scope: string; since: string }[]; guarantees: { title: string; text: string }[] }
const { id, label, title, lead, items, guarantees } = Astro.props;
---
<section class="ds-section ds-section--grid ds-references" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Eyebrow text={label} />
      <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <ul class="ds-references__list" role="list">
      {items.map((item) => <li data-reveal><ReferenceCard {...item} /></li>)}
    </ul>
    <ul class="ds-references__guarantees" role="list">
      {guarantees.map((guarantee) => (
        <li class="ds-references__guarantee" data-reveal>
          <strong class="ds-references__guarantee-title">{guarantee.title}</strong>
          <span class="ds-references__guarantee-text">{guarantee.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
