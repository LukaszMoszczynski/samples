---
// Report demo: a preview of the manager's panel with a finished cleaning report per staircase (checklist with times,
// photos before/after, crew notes). Tabs switch the staircase in place; ticks draw in one after another; the PDF
// button answers with demo text (osiedle.js). Without JS every report is shown, one under another.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
interface Report { tab: string; address: string; date: string; crew: string; start: string; end: string; tasks: { time: string; text: string }[]; note: string; photos: number }
interface Props { id: string; label: string; title: string; lead: string; points: string[]; disclaimer: string; reports: Report[] }
const { id, label, title, lead, points, disclaimer, reports } = Astro.props;
const stairs = 'M8 92h28V76h28V60h28V44h28V28h28';
const tick = 'm3.5 8.4 2.8 2.8 6.2-6.4';
---
<section class="ds-section ds-section--ink ds-report" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container ds-report__grid">
    <div class="ds-report__copy" data-reveal>
      <div class="ds-section-head">
        <Eyebrow text={label} tone="light" />
        <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
        <p class="ds-section-head__lead">{lead}</p>
      </div>
      <ul class="ds-report__points" role="list">
        {points.map((point) => (
          <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d={tick} /></svg>{point}</li>
        ))}
      </ul>
      <p class="ds-report__disclaimer">{disclaimer}</p>
    </div>
    <div class="ds-report__panel" data-report data-reveal>
      <div class="ds-report__bar">
        <span class="ds-report__bar-title">Panel zarządcy</span>
        <span class="ds-report__badge">Demo · przykładowe dane</span>
      </div>
      <div class="ds-report__tabs" role="tablist" aria-label="Wybierz klatkę" hidden data-report-tabs>
        {reports.map((report, index) => (
          <button class="ds-report__tab" type="button" role="tab" id={`report-tab-${index}`} aria-controls={`report-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-report-tab={index}>{report.tab}</button>
        ))}
      </div>
      {reports.map((report, index) => (
        <div class="ds-report__sheet" id={`report-panel-${index}`} role="tabpanel" aria-labelledby={`report-tab-${index}`} tabindex="0" data-report-sheet={index}>
          <div class="ds-report__head">
            <div>
              <p class="ds-report__address">{report.tab} · {report.address}</p>
              <h3 class="ds-report__title">Sprzątanie zakończone</h3>
            </div>
            <p class="ds-report__count"><span data-report-done>{report.tasks.length}</span>/{report.tasks.length} zadań</p>
          </div>
          <dl class="ds-report__meta">
            <div><dt>Data</dt><dd>{report.date}</dd></div>
            <div><dt>Ekipa</dt><dd>{report.crew}</dd></div>
            <div><dt>Start</dt><dd>{report.start}</dd></div>
            <div><dt>Koniec</dt><dd>{report.end}</dd></div>
          </dl>
          <div class="ds-report__progress" aria-hidden="true"><span data-report-bar></span></div>
          <ol class="ds-report__tasks" role="list">
            {report.tasks.map((task) => (
              <li class="ds-report__task" data-report-task>
                <span class="ds-report__check" aria-hidden="true"><svg viewBox="0 0 16 16"><path d={tick} pathLength="1000" data-draw data-report-tick /></svg></span>
                <span class="ds-report__task-text">{task.text}<span class="ds-visually-hidden">: wykonano</span></span>
                <time class="ds-report__time">{task.time}</time>
              </li>
            ))}
          </ol>
          <div class="ds-report__photos">
            <figure class="ds-report__photo ds-report__photo--before">
              <svg viewBox="0 0 160 100" aria-hidden="true">
                <path class="ds-report__stairs" d={stairs} />
                <g class="ds-report__dirt">
                  <circle cx="22" cy="88" r="2.5" /><circle cx="48" cy="72" r="2" /><circle cx="56" cy="73" r="3" /><circle cx="80" cy="56" r="2" />
                  <circle cx="104" cy="40" r="2.5" /><circle cx="112" cy="41" r="1.8" /><circle cx="132" cy="24" r="2.2" /><path d="M30 90l6-4M70 58l5-3M118 26l6-3" />
                </g>
              </svg>
              <figcaption>Przed · {report.start}</figcaption>
            </figure>
            <figure class="ds-report__photo ds-report__photo--after">
              <svg viewBox="0 0 160 100" aria-hidden="true">
                <path class="ds-report__stairs" d={stairs} />
                <path class="ds-report__sparkle" d="M126 8v10M121 13h10M44 46v8M40 50h8M86 30v6M83 33h6" />
              </svg>
              <figcaption>Po · {report.end}</figcaption>
            </figure>
            <p class="ds-report__photo-count">+{report.photos - 2} zdjęć w raporcie</p>
          </div>
          <p class="ds-report__note"><strong>Uwagi ekipy:</strong> {report.note}</p>
          <div class="ds-report__foot">
            <span class="ds-report__sign">Zatwierdził brygadzista · {report.end}</span>
            <button class="ds-report__pdf" type="button" data-report-pdf>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>
              Pobierz raport PDF
            </button>
          </div>
          <p class="ds-report__status" role="status" data-report-status></p>
        </div>
      ))}
    </div>
  </div>
</section>
