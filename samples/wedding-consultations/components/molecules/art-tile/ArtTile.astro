---
// Art tile: a small animated wedding scene in place of a photo (decorative). scene picks the drawing.
interface Props { scene: 'rings' | 'bouquet' | 'cake' | 'toast' | 'arch' | 'aisle' | 'dance' | 'villa' | 'invitation' }
const { scene } = Astro.props;
const heart = 'M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z';
const petals = [40, 95, 150, 210, 265, 320, 360];
const bulbs = Array.from({ length: 13 }, (_, index) => ({ x: 20 + index * 30, y: 40 + Math.sin(index / 2) * 14 }));
---
<svg class={`ds-art ds-art--${scene}`} viewBox="0 0 400 300" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  <rect class="ds-art__ground" width="400" height="300" />
  {scene === 'rings' && (
    <g>
      <circle cx="170" cy="165" r="58" class="ds-art__gold" />
      <circle cx="235" cy="165" r="58" class="ds-art__gold ds-art__gold--rose" />
      <path d="M235 100 l-12 -20 h24 z" class="ds-art__stone" />
      {[[110, 80], [300, 90], [290, 230], [120, 240], [205, 60]].map(([x, y], index) => <path d={`M${x} ${y - 9} L${x + 3} ${y - 3} L${x + 9} ${y} L${x + 3} ${y + 3} L${x} ${y + 9} L${x - 3} ${y + 3} L${x - 9} ${y} L${x - 3} ${y - 3} Z`} class="ds-art__spark" style={`animation-delay:${index * 0.4}s`} />)}
    </g>
  )}
  {scene === 'bouquet' && (
    <g>
      {[170, 185, 200, 215, 230].map((x) => <path d={`M200 270 Q ${x} 210 ${x} 160`} class="ds-art__stem" />)}
      <path d="M180 240 h40 l-6 30 h-28 z" class="ds-art__ribbon" />
      {[[170, 140, 26], [215, 128, 30], [245, 155, 22], [190, 105, 22], [150, 170, 18]].map(([x, y, r]) => <g class="ds-art__rose" style={`transform-origin:${x}px ${y}px`}><circle cx={x} cy={y} r={r} class="ds-art__petal-fill" /><path d={`M${x - r / 2} ${y} a${r / 2} ${r / 2} 0 1 1 ${r / 2} ${r / 2} a${r / 3} ${r / 3} 0 1 1 0 ${-r / 1.5}`} class="ds-art__line" /></g>)}
      {petals.map((x, index) => <g transform={`translate(${x} -20) scale(0.7)`}><path d={heart} class="ds-art__fall" style={`animation-delay:${index * 0.9}s`} /></g>)}
    </g>
  )}
  {scene === 'cake' && (
    <g>
      <rect x="120" y="200" width="160" height="60" rx="6" class="ds-art__tier" />
      <rect x="145" y="148" width="110" height="52" rx="6" class="ds-art__tier" />
      <rect x="170" y="104" width="60" height="44" rx="6" class="ds-art__tier" />
      {[220, 172, 126].map((y, index) => <path d={`M${125 + index * 25} ${y} q 10 10 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0`} class="ds-art__line" />)}
      <g transform="translate(188 64) scale(1)"><path d={heart} class="ds-art__beat" /></g>
      <line x1="80" y1="260" x2="320" y2="260" class="ds-art__line" />
    </g>
  )}
  {scene === 'toast' && (
    <g>
      <g class="ds-art__clink-left"><path d="M150 100 h50 l-8 70 h-34 z" class="ds-art__glass" /><line x1="175" y1="170" x2="175" y2="235" class="ds-art__line" /><line x1="155" y1="235" x2="195" y2="235" class="ds-art__line" /></g>
      <g class="ds-art__clink-right"><path d="M205 100 h50 l-8 70 h-34 z" class="ds-art__glass" /><line x1="230" y1="170" x2="230" y2="235" class="ds-art__line" /><line x1="210" y1="235" x2="250" y2="235" class="ds-art__line" /></g>
      {[165, 180, 220, 238, 195].map((x, index) => <circle cx={x} cy="160" r="3" class="ds-art__bubble" style={`animation-delay:${index * 0.5}s`} />)}
      <g transform="translate(190 58) scale(0.9)"><path d={heart} class="ds-art__beat" /></g>
    </g>
  )}
  {scene === 'arch' && (
    <g>
      <path d="M120 270 V140 A80 80 0 0 1 280 140 V270" class="ds-art__arch" />
      {[[120, 150], [140, 105], [175, 75], [225, 75], [260, 105], [280, 150]].map(([x, y]) => <circle cx={x} cy={y} r="14" class="ds-art__petal-fill" />)}
      {[0, 1].map((row) => <g>{[90, 130, 270, 310].map((x) => <rect x={x - 10} y={215 + row * 34} width="20" height="24" rx="3" class="ds-art__chair" />)}</g>)}
      {petals.map((x, index) => <g transform={`translate(${x} -20) scale(0.6)`}><path d={heart} class="ds-art__fall" style={`animation-delay:${index * 1.1}s`} /></g>)}
    </g>
  )}
  {scene === 'aisle' && (
    <g>
      <path d="M170 300 L195 120 M230 300 L205 120" class="ds-art__line" />
      <path d="M195 120 h10 L230 300 h-60 z" class="ds-art__runner" />
      {[0, 1, 2, 3].map((index) => <g><circle cx={150 - index * 18} cy={260 - index * 45} r={6 + index} class="ds-art__glow" style={`animation-delay:${index * 0.5}s`} /><circle cx={250 + index * 18} cy={260 - index * 45} r={6 + index} class="ds-art__glow" style={`animation-delay:${index * 0.5 + 0.25}s`} /></g>)}
      <g transform="translate(188 84) scale(1)"><path d={heart} class="ds-art__beat" /></g>
    </g>
  )}
  {scene === 'dance' && (
    <g>
      <path d="M20 40 Q 110 75 200 40 T 380 40" class="ds-art__wire" />
      {bulbs.map((bulb, index) => <circle cx={bulb.x} cy={bulb.y + 8} r="6" class="ds-art__bulb" style={`animation-delay:${(index % 4) * 0.4}s`} />)}
      <g class="ds-art__sway">
        <circle cx="185" cy="135" r="16" class="ds-art__figure" />
        <path d="M185 152 L160 260 h50 z" class="ds-art__dress" />
        <circle cx="222" cy="128" r="16" class="ds-art__figure" />
        <path d="M210 146 h24 v114 h-24 z" class="ds-art__figure" />
      </g>
      <ellipse cx="200" cy="268" rx="110" ry="10" class="ds-art__floor" />
    </g>
  )}
  {scene === 'villa' && (
    <g>
      <path d="M90 270 V150 L200 95 L310 150 V270 Z" class="ds-art__house" />
      {[[120, 175], [175, 175], [225, 175], [280, 175], [120, 225], [280, 225]].map(([x, y], index) => <rect x={x - 12} y={y - 16} width="24" height="30" rx="12" class="ds-art__window" style={`animation-delay:${index * 0.35}s`} />)}
      <path d="M185 270 v-45 a15 15 0 0 1 30 0 v45" class="ds-art__door" />
      {[50, 350].map((x) => <g><line x1={x} y1="270" x2={x} y2="215" class="ds-art__line" /><circle cx={x} cy="195" r="28" class="ds-art__tree" /></g>)}
      <line x1="20" y1="270" x2="380" y2="270" class="ds-art__line" />
    </g>
  )}
  {scene === 'invitation' && (
    <g>
      <g class="ds-art__letter"><rect x="135" y="80" width="130" height="120" rx="4" class="ds-art__paper" /><line x1="155" y1="120" x2="245" y2="120" class="ds-art__line" /><line x1="165" y1="140" x2="235" y2="140" class="ds-art__line" /><line x1="175" y1="160" x2="225" y2="160" class="ds-art__line" /></g>
      <path d="M110 150 h180 v110 h-180 z" class="ds-art__envelope" />
      <path d="M110 150 l90 60 l90 -60" class="ds-art__line" />
      <g transform="translate(186 196) scale(1.15)"><path d={heart} class="ds-art__seal" /></g>
    </g>
  )}
</svg>
