---
import HeartLabel from '../../atoms/heart-label/HeartLabel.astro';
interface Props { label: string; title: string; items: string[]; close: string }
const { label, title, items, close } = Astro.props;
---
<section class="ds-section ds-section--ink ds-know" aria-labelledby="know-title">
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <HeartLabel text={label} />
      <h2 class="ds-section-head__title" id="know-title"><Fragment set:html={title} /></h2>
    </div>
    <ul class="ds-know__list" role="list">
      {items.map((item) => (
        <li class="ds-know__item" data-know-item>
          <svg class="ds-know__heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z" data-know-heart /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <p class="ds-know__close" data-reveal>{close}</p>
  </div>
</section>
