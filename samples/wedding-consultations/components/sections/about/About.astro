---
import HeartLabel from '../../atoms/heart-label/HeartLabel.astro';
interface Props { label: string; title: string; paragraphs: string[]; quote: string }
const { label, title, paragraphs, quote } = Astro.props;
---
<section class="ds-section ds-about" id="o-mnie" aria-labelledby="o-mnie-title">
  <div class="ds-container ds-about__grid">
    <svg class="ds-about__frame" viewBox="0 0 300 380" aria-hidden="true">
      <path d="M30 370 V150 A120 120 0 0 1 270 150 V370 Z" fill="var(--color-surface-soft)" />
      <path d="M45 360 V152 A105 105 0 0 1 255 152 V360 Z" fill="none" stroke="var(--palette-accent-500)" stroke-width="1.5" pathLength="1" data-draw />
      <text x="150" y="250" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-style="italic" font-size="150" fill="var(--color-brand-primary)" data-monogram>K</text>
      <path transform="translate(138 290) scale(1)" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z" fill="var(--palette-accent-500)" data-beat />
      <text x="150" y="345" text-anchor="middle" font-family="Jost, sans-serif" font-size="11" letter-spacing="4" fill="var(--color-text-muted)">TU ZDJĘCIE KASI</text>
    </svg>
    <div data-reveal>
      <div class="ds-section-head">
        <HeartLabel text={label} />
        <h2 class="ds-section-head__title" id="o-mnie-title"><Fragment set:html={title} /></h2>
      </div>
      <div class="ds-about__text">{paragraphs.map((text) => <p>{text}</p>)}</div>
      <blockquote class="ds-about__quote">{quote}<span class="ds-about__sign">Kasia</span></blockquote>
    </div>
  </div>
</section>
