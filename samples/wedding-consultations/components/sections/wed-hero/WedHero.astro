---
// Wedding hero. The art (heart + rings) and the drifting hearts are decorative; wedding.js draws and floats them.
import HeartLabel from '../../atoms/heart-label/HeartLabel.astro';
import HeartButton from '../../atoms/heart-button/HeartButton.astro';
interface Props { label: string; title: string; accent: string; lead: string; facts: { value: string; count?: number; label: string }[] }
const { label, title, accent, lead, facts } = Astro.props;
const [before, after] = title.split(accent);
const heart = 'M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z';
const drift = Array.from({ length: 14 }, (_, index) => ({ left: (index * 37) % 100, size: 0.6 + ((index * 13) % 10) / 10 }));
---
<section class="ds-wed-hero" id="top" aria-labelledby="hero-title">
  <div class="ds-wed-hero__drift" aria-hidden="true">
    {drift.map((item) => (
      <svg class="ds-wed-hero__drift-heart" viewBox="0 0 24 24" style={`left:${item.left}%`} data-scale={item.size} data-drift-heart><path d={heart} /></svg>
    ))}
  </div>
  <div class="ds-container ds-wed-hero__grid">
    <div>
      <div data-hero-fade><HeartLabel text={label} /></div>
      <h1 class="ds-wed-hero__title" id="hero-title" data-hero-title>{before}<em data-hero-accent>{accent}</em>{after}</h1>
      <p class="ds-wed-hero__lead" data-hero-fade>{lead}</p>
      <div class="ds-wed-hero__actions" data-hero-fade>
        <HeartButton text="Umów konsultację" href="#rezerwacja" />
        <HeartButton text="Poznaj Kasię" href="#o-mnie" variant="outline" />
      </div>
      <ul class="ds-wed-hero__facts" role="list">
        {facts.map((fact) => (
          <li class="ds-wed-hero__fact" data-hero-fade>
            <span class="ds-wed-hero__fact-value">{fact.count !== undefined ? <><span data-count-to={fact.count}>{fact.count}</span>{fact.value}</> : fact.value}</span>
            <span class="ds-wed-hero__fact-label">{fact.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <svg class="ds-wed-hero__art" viewBox="0 0 400 380" aria-hidden="true">
      <path d="M200 350 C 120 300, 30 230, 30 140 C 30 80, 75 40, 125 40 C 160 40, 185 60, 200 90 C 215 60, 240 40, 275 40 C 325 40, 370 80, 370 140 C 370 230, 280 300, 200 350 Z" fill="none" stroke="var(--palette-accent-500)" stroke-width="2" stroke-linejoin="round" pathLength="1" data-hero-heart />
      <path d="M200 320 C 135 280, 60 220, 60 145 C 60 98, 95 68, 132 68" fill="none" stroke="var(--palette-primary-400)" stroke-width="1" pathLength="1" data-hero-heart-inner />
      <g data-hero-rings>
        <circle cx="172" cy="185" r="46" fill="none" stroke="var(--color-brand-primary)" stroke-width="7" pathLength="1" data-hero-ring />
        <circle cx="228" cy="185" r="46" fill="none" stroke="var(--palette-accent-500)" stroke-width="7" pathLength="1" data-hero-ring />
        <path d="M228 126 l-8 -14 h16 z" fill="var(--palette-accent-400)" stroke="var(--palette-accent-500)" stroke-width="1.5" data-hero-stone />
      </g>
      <path transform="translate(186 262) scale(1.2)" d={heart} fill="var(--color-brand-primary)" data-hero-small-heart />
    </svg>
  </div>
</section>
