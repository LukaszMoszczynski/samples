---
// Stories (recommendations) as a deck of wedding cards; wedding.js turns the column into a draggable deck.
// The quotes are examples, marked as such on the page, until the client adds real ones.
import HeartLabel from '../../atoms/heart-label/HeartLabel.astro';
import HeartButton from '../../atoms/heart-button/HeartButton.astro';
interface Props { label: string; title: string; hint: string; items: { quote: string; who: string }[]; note: string }
const { label, title, hint, items, note } = Astro.props;
const heart = 'M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z';
---
<section class="ds-section ds-section--blush ds-stories" id="rekomendacje" aria-labelledby="rekomendacje-title" data-stories>
  <div class="ds-container ds-stories__grid">
    <div data-reveal>
      <div class="ds-section-head">
        <HeartLabel text={label} />
        <h2 class="ds-section-head__title" id="rekomendacje-title"><Fragment set:html={title} /></h2>
        <p class="ds-stories__hint">{hint}</p>
      </div>
      <div class="ds-stories__controls">
        <button class="ds-heart-button ds-heart-button--outline" type="button" data-story-prev>← Poprzednia</button>
        <button class="ds-heart-button ds-heart-button--solid" type="button" data-story-next>Następna →</button>
      </div>
      <p class="ds-stories__note">{note}</p>
      <p class="ds-visually-hidden" aria-live="polite" data-story-announce></p>
    </div>
    <div class="ds-stories__deck" role="group" tabindex="0" aria-label="Rekomendacje: strzałki zmieniają kartkę" data-story-deck>
      {items.map((item) => (
        <figure class="ds-story" data-story>
          <span class="ds-story__seal" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={heart} /></svg></span>
          <blockquote class="ds-story__quote">{item.quote}</blockquote>
          <figcaption class="ds-story__who">{item.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
