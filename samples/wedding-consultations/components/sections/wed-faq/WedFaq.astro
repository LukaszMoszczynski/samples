---
import HeartLabel from '../../atoms/heart-label/HeartLabel.astro';
interface Props { label: string; title: string; items: { question: string; answer: string }[] }
const { label, title, items } = Astro.props;
const heart = 'M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) };
---
<section class="ds-section ds-wed-faq" id="pytania" aria-labelledby="pytania-title">
  <div class="ds-container">
    <div class="ds-section-head ds-section-head--center" data-reveal>
      <HeartLabel text={label} />
      <h2 class="ds-section-head__title" id="pytania-title"><Fragment set:html={title} /></h2>
    </div>
    <div class="ds-wed-faq__list" data-reveal>
      {items.map((item) => (
        <details class="ds-wed-faq__item" data-faq-item>
          <summary class="ds-wed-faq__question">{item.question}<svg class="ds-wed-faq__heart" viewBox="0 0 24 24" aria-hidden="true"><path d={heart} /></svg></summary>
          <div class="ds-wed-faq__panel" data-faq-panel><p class="ds-wed-faq__answer">{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
