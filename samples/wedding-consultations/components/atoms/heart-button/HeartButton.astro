---
interface Props { text: string; href?: string; variant?: 'solid' | 'outline' | 'light'; type?: 'button' | 'submit' }
const { text, href, variant = 'solid', type = 'button' } = Astro.props;
const className = `ds-heart-button ds-heart-button--${variant}`;
const heart = '<svg class="ds-heart-button__heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.9 1.3 5.4 3.2 1.5-1.9 3.2-3.2 5.4-3.2 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg>';
---
{href
  ? <a class={className} href={href}>{text}<Fragment set:html={heart} /></a>
  : <button class={className} type={type}>{text}<Fragment set:html={heart} /></button>}
