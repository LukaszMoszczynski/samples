---
// Service card: line icon, name, what it is for, duration and price, and a link that picks the service in the booking
// demo. Lifts softly on hover; the icon's line redraws.
interface Props { icon: string; title: string; text: string; duration: string; price: string; anchor: string }
const { icon, title, text, duration, price, anchor } = Astro.props;
const icons: Record<string, string> = {
  hands: 'M8 20c-2-3-3-6-3-9 0-2 1-3 2-3s2 1 2 3v2M9 13V6c0-1 1-2 2-2s2 1 2 2v6m0-1V5c0-1 1-2 2-2s2 1 2 2v7m0-3c0-1 1-2 2-2s2 1 2 2v4c0 4-2 7-5 9',
  knee: 'M9 3v7c0 2 1 3 3 3s3 1 3 3v5M6 21h6M12 13c-2 0-3 1-3 3v5M15 3v4',
  spine: 'M12 3v18M9 5h6M8 9h8M8.5 13h7M9 17h6',
  run: 'M14 5a1.5 1.5 0 1 0 0-.1M6 21l3-5 3 1 1-5 3 3h3M9 9l3-2 2 1 1 3M4 13h4',
  bloom: 'M12 21v-6M12 15c-4 0-7-3-7-7 4 0 7 3 7 7Zm0 0c4 0 7-3 7-7-4 0-7 3-7 7Zm0-3c-2-2-2-6 0-9 2 3 2 7 0 9Z',
  wave: 'M3 15c3-4 6-4 9 0s6 4 9 0M3 9c3-4 6-4 9 0s6 4 9 0',
  tape: 'M5 19 19 5M8 21l13-13M3 16 16 3M9 9l6 6',
  home: 'M4 11 12 4l8 7v9H4zM10 20v-5h4v5',
  consult: 'M5 4h14v12H9l-4 4zM9 9h6M9 12h4',
};
---
<article class="ds-service-card" id={anchor}>
  <div class="ds-service-card__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[icon]} pathLength="1000" /></svg>
  </div>
  <h3 class="ds-service-card__title">{title}</h3>
  <p class="ds-service-card__text">{text}</p>
  <dl class="ds-service-card__meta">
    <div><dt>Czas</dt><dd>{duration}</dd></div>
    <div><dt>Cena</dt><dd>{price}</dd></div>
  </dl>
  <a class="ds-service-card__link" href="#rezerwacja" data-book-service={title}>Umów termin<span class="ds-visually-hidden">: {title}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
</article>
