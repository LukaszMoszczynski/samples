---
// Brand mark: the round sign (a figure drawn in one flowing line, a coral reach) and the name. A placeholder logo.
interface Props { name: string; href?: string; tone?: 'dark' | 'light' }
const { name, href = '#top', tone = 'dark' } = Astro.props;
---
<a class={`ds-brand-mark ds-brand-mark--${tone}`} href={href}>
  <svg class="ds-brand-mark__sign" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="20" class="ds-brand-mark__disc" />
    <circle cx="23.5" cy="10.5" r="3.4" class="ds-brand-mark__head" />
    <path d="M22 16c-6 5 3 9-4 17" class="ds-brand-mark__body" />
    <path d="M11 19c5 2 12 1 18-5" class="ds-brand-mark__reach" />
  </svg>
  <span class="ds-brand-mark__name">{name}</span>
</a>
