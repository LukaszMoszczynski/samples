---
// Site header: brand, menu, "Umów wizytę". Below 1024 px a burger opens a full-screen drawer (physio.js), which sits
// after the header in the page: a blurred header would trap a fixed child.
import BrandMark from '../../atoms/brand-mark/BrandMark.astro';
import PillButton from '../../atoms/pill-button/PillButton.astro';
interface Props { name: string; items: { text: string; href: string }[]; cta: { text: string; href: string }; phone: string }
const { name, items, cta, phone } = Astro.props;
---
<header class="ds-site-header" data-site-header>
  <div class="ds-container ds-site-header__bar">
    <BrandMark name={name} />
    <nav class="ds-site-header__nav" aria-label="Menu główne">
      <ul class="ds-site-header__menu" role="list">
        {items.map((item) => <li><a class="ds-site-header__link" href={item.href}>{item.text}</a></li>)}
      </ul>
    </nav>
    <div class="ds-site-header__cta"><PillButton text={cta.text} href={cta.href} /></div>
    <button class="ds-site-header__burger" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Menu" data-site-burger>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="ds-burger__line ds-burger__line--top" d="M4 8h16" /><path class="ds-burger__line ds-burger__line--middle" d="M4 12h16" /><path class="ds-burger__line ds-burger__line--bottom" d="M4 16h16" /></svg>
    </button>
  </div>
</header>
<div class="ds-site-header__drawer" id="site-drawer" hidden>
  <div class="ds-container">
    <ul class="ds-site-header__drawer-menu" role="list">
      {items.map((item) => <li><a class="ds-site-header__drawer-link" href={item.href}>{item.text}</a></li>)}
    </ul>
    <div class="ds-site-header__drawer-foot">
      <PillButton text={cta.text} href={cta.href} />
      <a class="ds-site-header__phone" href={`tel:${phone.replaceAll(' ', '')}`}>{phone}</a>
    </div>
  </div>
</div>
