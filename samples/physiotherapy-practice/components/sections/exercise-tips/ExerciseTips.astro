---
// Exercise tips: a breathing ring to start (it grows on the in-breath, shrinks on the out-breath; physio.js), three
// simple exercises with moving line figures, and the reminder that tips do not replace a consultation.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
interface Props { id: string; label: string; title: string; lead: string; disclaimer: string }
const { id, label, title, lead, disclaimer } = Astro.props;
---
<section class="ds-section ds-exercise-tips" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-exercise-tips__head">
      <div class="ds-section-head" data-reveal>
        <Eyebrow text={label} />
        <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
        <p class="ds-section-head__lead">{lead}</p>
      </div>
      <div class="ds-exercise-tips__breath" data-reveal>
        <div class="ds-exercise-tips__ring" aria-hidden="true">
          <span class="ds-exercise-tips__ring-wave" data-breath-ring></span>
          <span class="ds-exercise-tips__ring-core"></span>
          <span class="ds-exercise-tips__ring-word" data-breath-word>Wdech</span>
        </div>
        <div class="ds-exercise-tips__breath-copy">
          <p class="ds-exercise-tips__breath-title">Zacznij od trzech spokojnych oddechów</p>
          <p class="ds-exercise-tips__breath-text">Wdech nosem przez 4 sekundy, wydech ustami przez 6 sekund. Ramiona luźno.</p>
        </div>
      </div>
    </div>
    <ul class="ds-exercise-tips__list" role="list">
      <slot />
    </ul>
    <p class="ds-note" data-reveal>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16v.5" /></svg>
      <span>{disclaimer}</span>
    </p>
  </div>
</section>
