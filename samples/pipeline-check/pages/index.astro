---
// Starter page: Hero, Text + image and Call to action from the design system. Replace the copy with the brief's.
import Sample from '../layouts/Sample.astro';
import sample from '../sample.json';

import '../ds/components/atoms/icon/icon.css';
import '../ds/components/atoms/text/text.css';
import '../ds/components/atoms/button/button.css';
import '../ds/components/atoms/tag/tag.css';
import '../ds/components/atoms/link/link.css';
import '../ds/components/atoms/number/number.css';
import '../ds/components/atoms/breadcrumbs/breadcrumbs.css';
import '../ds/components/molecules/card-hero-tile/card-hero-tile.css';
import '../ds/components/molecules/heading-group/heading-group.css';
import '../ds/components/molecules/numbered-list/numbered-list.css';
import '../ds/components/molecules/badge-circular/badge-circular.css';
import '../ds/components/sections/hero/hero.css';
import '../ds/components/sections/text-image/text-image.css';
import '../ds/components/organisms/call-to-action/call-to-action.css';
import '../components/sections/page-section/page-section.css';

import { renderHero } from '../ds/components/sections/hero/hero.template.js';
import { renderTextImage } from '../ds/components/sections/text-image/text-image.template.js';
import { renderCallToAction } from '../ds/components/organisms/call-to-action/call-to-action.template.js';
import wide from '../ds/placeholders/wide.svg?url';
import landscape from '../ds/placeholders/landscape.svg?url';

const hero = renderHero({
  variant: 'large',
  title: 'A clear site for a growing company',
  lead: 'What the company does, in one sentence.',
  subtitle: '',
  button: { text: 'Get in touch', href: '#contact' },
  tiles: [],
  image: wide,
  imageAlt: '',
});
const about = renderTextImage({
  variant: 'image-right',
  overline: 'About',
  title: 'What makes the company different',
  text: 'Two or three sentences from the brief, in our own words.',
  actions: [],
  image: landscape,
  imageAlt: '',
});
const contact = renderCallToAction({
  variant: 'band',
  title: 'Let’s talk',
  text: 'One line on what happens after the first message.',
  buttons: [{ text: 'Write to us', href: '#contact' }],
});
---
<Sample lang={sample.lang} title={sample.title}>
  <main>
    <Fragment set:html={hero} />
    <Fragment set:html={about} />
    <section id="contact" class="ds-page-section" aria-label="Contact"><Fragment set:html={contact} /></section>
  </main>
</Sample>
