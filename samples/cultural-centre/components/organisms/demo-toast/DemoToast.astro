---
// Demo toast: a polite live region in the bottom-right corner. Demo actions (ticket links) say what the real site would
// do, without sending or buying anything. Filled and shown by centre.js.
---
<div class="ds-demo-toast" role="status" aria-live="polite" data-demo-toast>
  <div class="ds-demo-toast__card" hidden data-demo-toast-card>
    <p class="ds-demo-toast__title" data-demo-toast-title></p>
    <p class="ds-demo-toast__text" data-demo-toast-text></p>
    <button class="ds-demo-toast__close" type="button" data-demo-toast-close>Zamknij</button>
  </div>
</div>
