---
// Accessibility page: the accessibility statement, the building's access, easy-to-read text and sign-language
// information, as a public institution publishes them. Example text; dates and names are marked to fill in.
import CentrePage from '../layouts/CentrePage.astro';
import '../components/sections/page-hero/page-hero.css';
import '../components/sections/access-statement/access-statement.css';

import PageHero from '../components/sections/page-hero/PageHero.astro';
import AccessStatement from '../components/sections/access-statement/AccessStatement.astro';
import { centre } from '../data/content.js';

const base = `${import.meta.env.BASE_URL}cultural-centre/`;
---
<CentrePage current="dostepnosc" title="Dostępność" description="Deklaracja dostępności domu kultury, dostępność budynku, tekst łatwy do czytania i informacja w polskim języku migowym.">
  <PageHero
    home={base}
    current="Dostępność"
    label="Dostępność"
    title="Dom kultury dla wszystkich"
    lead="Tu jest deklaracja dostępności strony, opis budynku, tekst łatwy do czytania i informacja o tłumaczu polskiego języka migowego. Rozmiar tekstu i kontrast zmienisz na górze każdej strony."
    shapes={[{ shape: 'arch', ink: 'blue' }, { shape: 'circle', ink: 'green' }, { shape: 'star', ink: 'blue' }]}
  />
  <AccessStatement
    name={centre.name}
    phone={centre.phone}
    email={centre.email}
    sections={[
      { id: 'deklaracja', title: 'Deklaracja dostępności' },
      { id: 'architektura', title: 'Dostępność budynku' },
      { id: 'tekst-latwy', title: 'Tekst łatwy do czytania' },
      { id: 'jezyk-migowy', title: 'Polski język migowy' },
    ]}
  />
</CentrePage>
