---
// Demo cart: a drawer from the right with items, quantities, a free-delivery bar and totals, then a short checkout
// step (delivery, e-mail, postcode, payment) and a thank-you. Sample only: nothing is charged or sent (cart.js).
// In the finished site: the WooCommerce cart and checkout.
import ShopButton from '../../atoms/shop-button/ShopButton.astro';
import { products } from '../../../data/catalog';
interface Props { freeFrom: number }
const { freeFrom } = Astro.props;
const catalog = Object.fromEntries(products.map((product) => [product.id, { name: product.name, type: product.type, price: product.price, delivery: product.delivery, text: product.text, page: Boolean(product.page) }]));
---
<script type="application/json" is:inline data-catalog set:html={JSON.stringify(catalog)}></script>
<dialog class="ds-cart" aria-labelledby="cart-title" data-cart data-free-from={String(freeFrom)}>
  <div class="ds-cart__panel" data-cart-panel>
    <div class="ds-cart__head">
      <h2 class="ds-cart__title" id="cart-title">Koszyk</h2>
      <p class="ds-demo-note">Demo sklepu</p>
      <button class="ds-cart__close" type="button" aria-label="Zamknij koszyk" data-cart-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <ol class="ds-cart__steps" aria-label="Kroki zamówienia">
      <li class="ds-cart__step-mark" data-step-mark="list" aria-current="step">Koszyk</li>
      <li class="ds-cart__step-mark" data-step-mark="checkout">Dostawa i płatność</li>
      <li class="ds-cart__step-mark" data-step-mark="thanks">Gotowe</li>
    </ol>

    <div class="ds-cart__step" data-cart-step="list">
      <p class="ds-cart__empty" data-cart-empty>Koszyk jest pusty. Wybierz coś z kolekcji, a pojawi się tutaj.</p>
      <ul class="ds-cart__items" role="list" data-cart-items></ul>
      <div class="ds-cart__free" data-cart-free hidden>
        <p class="ds-cart__free-text" data-cart-free-text></p>
        <div class="ds-cart__free-track"><span class="ds-cart__free-bar" data-cart-free-bar></span></div>
      </div>
      <dl class="ds-cart__summary" data-cart-summary hidden>
        <div><dt>Produkty</dt><dd data-cart-subtotal>0 zł</dd></div>
        <div><dt>Dostawa</dt><dd>wybierzesz w następnym kroku</dd></div>
      </dl>
      <div class="ds-cart__actions">
        <ShopButton text="Przejdź do dostawy" attrs={{ 'data-cart-checkout': '' }} />
        <button class="ds-cart__link" type="button" data-cart-close>Kontynuuj zakupy</button>
      </div>
    </div>

    <form class="ds-cart__step ds-cart__checkout" data-cart-step="checkout" data-checkout-form hidden>
      <fieldset class="ds-cart__group">
        <legend class="ds-cart__legend">Dostawa</legend>
        <label class="ds-cart__option"><input type="radio" name="delivery" value="assembly" data-delivery-price="149" checked /><span><strong>Z wniesieniem i montażem</strong><small>149 zł, gratis od {freeFrom.toLocaleString('pl-PL')} zł · zabieramy kartony</small></span></label>
        <label class="ds-cart__option"><input type="radio" name="delivery" value="door" data-delivery-price="79" /><span><strong>Do drzwi</strong><small>79 zł · kurier meblowy, 2 dni robocze od wysyłki</small></span></label>
        <label class="ds-cart__option"><input type="radio" name="delivery" value="showroom" data-delivery-price="0" /><span><strong>Odbiór w salonie</strong><small>0 zł · pomożemy zapakować do auta</small></span></label>
      </fieldset>
      <div class="ds-cart__fields">
        <div class="ds-cart__field">
          <label class="ds-cart__label" for="checkout-email">E-mail</label>
          <input class="ds-cart__input" id="checkout-email" name="email" type="email" autocomplete="email" placeholder="imie@example.com" required />
        </div>
        <div class="ds-cart__field">
          <label class="ds-cart__label" for="checkout-postcode">Kod pocztowy</label>
          <input class="ds-cart__input" id="checkout-postcode" name="postcode" autocomplete="postal-code" inputmode="numeric" placeholder="00-000" required />
        </div>
        <div class="ds-cart__field ds-cart__field--wide">
          <label class="ds-cart__label" for="checkout-pay">Płatność</label>
          <select class="ds-cart__input" id="checkout-pay" name="pay">
            <option>BLIK</option>
            <option>Szybki przelew</option>
            <option>Karta płatnicza</option>
            <option>Raty 0% (10 × bez odsetek)</option>
          </select>
        </div>
      </div>
      <label class="ds-cart__consent"><input type="checkbox" name="terms" required /><span>Akceptuję regulamin sklepu (demo).</span></label>
      <dl class="ds-cart__summary">
        <div><dt>Produkty</dt><dd data-cart-subtotal>0 zł</dd></div>
        <div><dt>Dostawa</dt><dd data-cart-delivery>0 zł</dd></div>
        <div class="ds-cart__total"><dt>Do zapłaty</dt><dd data-cart-total>0 zł</dd></div>
      </dl>
      <div class="ds-cart__actions">
        <ShopButton text="Zamawiam i płacę (demo)" type="submit" variant="accent" />
        <button class="ds-cart__link" type="button" data-cart-back>← Wróć do koszyka</button>
      </div>
    </form>

    <div class="ds-cart__step ds-cart__thanks" data-cart-step="thanks" role="status" hidden>
      <svg class="ds-cart__thanks-mark" viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="29" pathLength="1000" data-thanks-ring /><path d="m20 33 8 8 16-17" pathLength="1000" data-thanks-tick /></svg>
      <p class="ds-cart__thanks-title">Dziękujemy za zamówienie!</p>
      <p>W prawdziwym sklepie tu przyjdzie potwierdzenie z numerem zamówienia i terminem dostawy. To demo: nic nie zostało pobrane ani wysłane.</p>
      <button class="ds-cart__link" type="button" data-cart-close>Wróć do sklepu</button>
    </div>
  </div>
</dialog>
