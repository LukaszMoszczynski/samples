        <path class="ds-art__wood-shade" d="M140 56h20l-3 -12h-14z" />
        <rect class="ds-art__fabric-shade" x="128" y="72" width="10" height="26" rx="1" />
        <rect class="ds-art__fabric" x="140" y="76" width="9" height="22" rx="1" />
        <rect class="ds-art__pillow" x="151" y="70" width="11" height="28" rx="1" />
        <ellipse class="ds-art__pillow" cx="88" cy="90" rx="16" ry="8" />
        <rect class="ds-art__fabric" x="66" y="128" width="48" height="10" rx="2" />
        <rect class="ds-art__pillow" x="70" y="118" width="40" height="10" rx="2" />
        <rect class="ds-art__wood-shade" x="128" y="116" width="44" height="38" rx="2" />
        <path class="ds-art__seam" d="M150 130v10" />
      </Fragment>
    )}
    {kind === 'sideboard' && (
      <Fragment>
        <path class="ds-art__wood-shade" d="M40 132h8l-2 28h-5zM192 132h8l-1 28h-5z" />
        <rect class="ds-art__wood" x="22" y="68" width="196" height="66" rx="6" />
        <path class="ds-art__seam" d="M88 74v54M152 74v54" />
        <path class="ds-art__handle" d="M80 92v18M96 92v18M160 92v18" />
        <rect class="ds-art__wood-shade" x="22" y="62" width="196" height="8" rx="3" />
        <path class="ds-art__plant" d="M178 62c-12-8-14-20-6-26 4 8 6 16 6 26zm0 0c10-8 16-18 8-24-6 6-8 14-8 24z" />
        <rect class="ds-art__fabric" x="50" y="44" width="40" height="18" rx="3" />
        <rect class="ds-art__pillow" x="54" y="36" width="32" height="8" rx="2" />
      </Fragment>
    )}
    {kind === 'bed' && (
      <Fragment>
        <path class="ds-art__wood" d="M32 138h9l-2 22h-5zM199 138h9l-1 22h-5z" />
        <rect class="ds-art__fabric" x="30" y="30" width="180" height="84" rx="20" />
        <path class="ds-art__seam" d="M75 40v56M120 40v56M165 40v56" />
