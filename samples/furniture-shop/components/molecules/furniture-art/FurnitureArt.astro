---
// Furniture drawn as clean flat SVG (no product photos): one drawing per kind of piece. Fabric and wood colours come in
// as CSS custom properties (--art-fabric, --art-wood), so a swatch click recolours the drawing smoothly (CSS fill
// transition). Standalone it is an <svg role="img">; with x/y/width it becomes a scaled <g> inside a larger scene (the
// hero), because a nested <svg> takes its height from page CSS.
import type { ArtKind } from '../../../data/catalog';
interface Props {
  kind: ArtKind;
  fabric?: string;
  wood?: string;
  label?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  class?: string;
  attrs?: Record<string, string>;
}
const { kind, fabric = 'var(--palette-secondary-100)', wood = 'var(--palette-primary-400)', label = '', x = 0, y = 0, width, class: extra = '', attrs = {} } = Astro.props;
const nested = width !== undefined;
const Tag = nested ? 'g' : 'svg';
const style = `--art-fabric: ${fabric}; --art-wood: ${wood};`;
const placement = nested
  ? { transform: `translate(${x} ${y}) scale(${(width / 240).toFixed(4)})` }
  : { viewBox: '0 0 240 180', role: label ? 'img' : undefined, 'aria-label': label || undefined, 'aria-hidden': label ? undefined : 'true' };
---
<Tag
  class:list={['ds-art', `ds-art--${kind}`, { 'ds-art--block': !nested }, extra]}
  style={style}
  {...placement}
  data-art
  {...attrs}
>
  <ellipse class="ds-art__shadow" cx="120" cy="162" rx={kind === 'armchair' || kind === 'chair' || kind === 'chair-soft' ? 62 : 100} ry="6" />
  <g class="ds-art__body" data-art-body>
    {kind === 'sofa' && (
      <Fragment>
        <path class="ds-art__wood" d="M44 138h9l-3 22h-4zM187 138h9l-2 22h-4z" />
        <rect class="ds-art__fabric" x="40" y="56" width="160" height="56" rx="16" />
        <rect class="ds-art__fabric-shade" x="20" y="84" width="36" height="58" rx="13" />
        <rect class="ds-art__fabric-shade" x="184" y="84" width="36" height="58" rx="13" />
        <rect class="ds-art__fabric" x="46" y="110" width="148" height="32" rx="9" />
        <rect class="ds-art__fabric-light" x="58" y="64" width="60" height="40" rx="13" />
        <rect class="ds-art__fabric-light" x="122" y="64" width="60" height="40" rx="13" />
        <rect class="ds-art__fabric" x="56" y="98" width="63" height="22" rx="8" />
        <rect class="ds-art__fabric" x="121" y="98" width="63" height="22" rx="8" />
        <rect class="ds-art__pillow" x="150" y="70" width="30" height="28" rx="8" transform="rotate(-8 165 84)" />
        <path class="ds-art__seam" d="M66 128h108" />
      </Fragment>
    )}
    {kind === 'armchair' && (
      <Fragment>
        <path class="ds-art__wood" d="M84 138h9l-3 22h-4zM147 138h9l-2 22h-4z" />
        <rect class="ds-art__fabric" x="72" y="26" width="96" height="96" rx="34" />
        <rect class="ds-art__fabric-light" x="84" y="40" width="72" height="58" rx="22" />
        <rect class="ds-art__fabric-shade" x="58" y="80" width="28" height="62" rx="12" />
        <rect class="ds-art__fabric-shade" x="154" y="80" width="28" height="62" rx="12" />
        <rect class="ds-art__fabric" x="80" y="98" width="80" height="44" rx="11" />
        <path class="ds-art__seam" d="M90 116h60" />
      </Fragment>
    )}
    {kind === 'table-round' && (
      <Fragment>
        <ellipse class="ds-art__wood-shade" cx="120" cy="152" rx="40" ry="8" />
        <path class="ds-art__wood" d="M111 90h18l7 60h-32z" />
        <path class="ds-art__wood-shade" d="M26 74v9c0 8 42 15 94 15s94-7 94-15v-9z" />
        <ellipse class="ds-art__wood" cx="120" cy="74" rx="94" ry="15" />
        <path class="ds-art__grain" d="M60 72c20-4 44 6 66 1s30-5 52-1" />
        <path class="ds-art__pillow" d="M104 70c0-12 32-12 32 0z" />
      </Fragment>
    )}
    {kind === 'table-long' && (
      <Fragment>
        <path class="ds-art__wood" d="M38 88h11l-3 72h-6zM191 88h11l-2 72h-6z" />
        <path class="ds-art__wood-shade" d="M60 88h8l-2 60h-5zM172 88h8l-1 60h-5z" />
        <rect class="ds-art__wood-shade" x="34" y="78" width="172" height="12" rx="2" />
        <rect class="ds-art__wood" x="16" y="66" width="208" height="14" rx="4" />
        <path class="ds-art__grain" d="M34 72c30-3 60 3 92 0s52-3 80 0" />
        <path class="ds-art__pillow" d="M96 66c0-14 48-14 48 0z" />
      </Fragment>
    )}
    {kind === 'coffee-table' && (
      <Fragment>
        <path class="ds-art__wood" d="M54 110h9l-2 50h-6zM177 110h9l-1 50h-6zM116 116h8l-1 46h-6z" />
        <ellipse class="ds-art__wood-shade" cx="120" cy="138" rx="66" ry="9" />
        <path class="ds-art__wood-shade" d="M34 100v8c0 7 38 13 86 13s86-6 86-13v-8z" />
        <ellipse class="ds-art__wood" cx="120" cy="100" rx="86" ry="14" />
        <rect class="ds-art__fabric" x="72" y="86" width="44" height="8" rx="2" />
        <rect class="ds-art__pillow" x="76" y="79" width="38" height="8" rx="2" />
        <path class="ds-art__grain" d="M64 102c22 3 54-4 76 0s24 1 34-1" />
      </Fragment>
    )}
    {kind === 'chair' && (
      <Fragment>
        <path class="ds-art__wood" d="M82 114h9l-3 46h-5zM149 114h9l-2 46h-5z" />
        <rect class="ds-art__wood" x="84" y="34" width="8" height="78" rx="3" />
        <rect class="ds-art__wood" x="148" y="34" width="8" height="78" rx="3" />
        <rect class="ds-art__wood" x="80" y="26" width="80" height="16" rx="6" />
        <path class="ds-art__wood-shade" d="M104 42h6v58h-6zM117 42h6v58h-6zM130 42h6v58h-6z" />
        <rect class="ds-art__fabric" x="74" y="100" width="92" height="16" rx="5" />
        <path class="ds-art__weave" d="M84 104l8 8M96 104l8 8M108 104l8 8M120 104l8 8M132 104l8 8M144 104l8 8" />
        <rect class="ds-art__wood-shade" x="88" y="140" width="66" height="5" rx="2" />
      </Fragment>
    )}
    {kind === 'chair-soft' && (
      <Fragment>
        <path class="ds-art__wood" d="M84 120h9l-4 40h-5zM147 120h9l-2 40h-5z" />
        <rect class="ds-art__fabric" x="84" y="30" width="72" height="76" rx="24" />
        <path class="ds-art__seam" d="M100 48c12 4 28 4 40 0" />
        <rect class="ds-art__fabric-shade" x="74" y="98" width="92" height="26" rx="11" />
      </Fragment>
