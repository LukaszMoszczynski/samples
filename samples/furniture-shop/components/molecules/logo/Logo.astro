---
// Logo: a placeholder wordmark, "Twoje Meble", with a small drawn armchair in an ochre circle. Inline, so it uses the
// page's heading font; assets/logo.svg and logo-light.svg are the same mark for the link preview and elsewhere.
interface Props { tone?: 'dark' | 'light' }
const { tone = 'dark' } = Astro.props;
---
<span class:list={['ds-logo', { 'ds-logo--light': tone === 'light' }]}>
  <svg class="ds-logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="20" class="ds-logo__disc" />
    <path class="ds-logo__chair" d="M12.5 27.5v-9.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9.5M10 19.5h4v5h12v-5h4M14 24.5v5M26 24.5v5" />
  </svg>
  <span class="ds-logo__word">Twoje <em>Meble</em></span>
</span>
