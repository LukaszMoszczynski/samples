const drawing = drawings[name];
const withLength = (markup: string) => markup.replace(/<(path|circle|ellipse|rect|line|polyline)\s/g, '<$1 pathLength="1000" ');
const smokeLines = drawing.smoke?.replace(/<path\s/g, '<path pathLength="1000" ');
---
<svg class:list={['ds-art', `ds-art--${tone}`, `ds-art--${name}`, extra]} viewBox={drawing.viewBox} data-draw data-art={name} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <g data-fill set:html={drawing.fills} />
  <g class="ds-art__lines" set:html={withLength(drawing.lines)} />
  {smokeLines && <g class="ds-art__smoke" data-smoke set:html={smokeLines} />}
</svg>
