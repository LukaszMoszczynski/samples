---
// Diner art: drawn dishes and props instead of photos. Each drawing is colour fills (data-fill, they fade in) under ink
// outlines (pathLength 1000, they draw in when the script plays them: diner.js). tone: day (navy ink on cream) or
// night (cream ink on midnight). The smoker has smoke curls (data-smoke) that keep rising.
interface Props { name: Drawing; tone?: 'day' | 'night'; class?: string; label?: string }
export type Drawing = 'burger' | 'ribs' | 'wings' | 'fries' | 'shake' | 'pancakes' | 'guitar' | 'dice' | 'jukebox' | 'smoker';
