---
// Visit: opening hours with today's row marked (diner.js), address and ways to get here, contact, and a drawn map
// placeholder: the roads draw in, then the pin drops onto the diner by the "66" road sign.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
interface Props {
  id: string; eyebrow: string; title: string;
  hours: { days: string; weekdays: number[]; time: string }[];
  brunch: string; address: string[];
  ways: { label: string; text: string }[];
  phone: string; email: string;
}
const { id, eyebrow, title, hours, brunch, address, ways, phone, email } = Astro.props;
---
<section class="ds-section ds-visit" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Eyebrow text={eyebrow} />
      <h2 class="ds-section-head__title" id={`${id}-title`} set:html={title} />
    </div>
    <div class="ds-visit__grid">
      <div class="ds-visit__info">
        <div class="ds-visit__block" data-reveal>
          <h3 class="ds-visit__title">Godziny otwarcia</h3>
          <ul class="ds-visit__hours" role="list">
            {hours.map((row) => (
              <li class="ds-visit__hour" data-weekdays={row.weekdays.join(',')}>
                <span>{row.days}<span class="ds-visit__today" data-today-label hidden>dziś</span></span>
                <span class="ds-visit__time">{row.time}</span>
              </li>
            ))}
          </ul>
          <p class="ds-visit__small">{brunch}</p>
        </div>
        <div class="ds-visit__block" data-reveal>
          <h3 class="ds-visit__title">Adres i kontakt</h3>
          <address class="ds-visit__address">
            {address.map((line) => <span>{line}</span>)}
            <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
            <a href={`mailto:${email}`}>{email}</a>
          </address>
        </div>
        <div class="ds-visit__block" data-reveal>
          <h3 class="ds-visit__title">Jak dojechać</h3>
          <dl class="ds-visit__ways">
            {ways.map((way) => (
              <div class="ds-visit__way"><dt>{way.label}</dt><dd>{way.text}</dd></div>
            ))}
          </dl>
        </div>
      </div>
      <figure class="ds-visit__map" data-reveal data-map>
        <svg class="ds-visit__map-svg" viewBox="0 0 480 420" role="img" aria-label="Mapa poglądowa: diner przy skrzyżowaniu, obok parking">
          <rect class="ds-visit__map-ground" width="480" height="420" rx="24" />
          <rect class="ds-visit__map-park" x="300" y="40" width="140" height="110" rx="14" />
          <rect class="ds-visit__map-lot" x="60" y="250" width="150" height="120" rx="12" />
          <g class="ds-visit__map-roads" data-map-lines>
            <path pathLength="1000" d="M-10 210C120 200 200 230 300 214S440 190 490 200" />
            <path pathLength="1000" d="M250 -10C240 100 262 160 250 214S236 340 252 430" />
            <path pathLength="1000" d="M250 214C300 260 360 300 490 320" />
          </g>
          <g class="ds-visit__map-lines" data-map-center>
            <path pathLength="1000" d="M-10 210C120 200 200 230 300 214S440 190 490 200" />
            <path pathLength="1000" d="M250 -10C240 100 262 160 250 214S236 340 252 430" />
          </g>
          <text class="ds-visit__map-label" x="370" y="100" text-anchor="middle">PARK</text>
          <text class="ds-visit__map-label" x="135" y="316" text-anchor="middle">PARKING</text>
          <g class="ds-visit__map-shield" transform="translate(360 238)">
            <path d="M0 0h44l-4 30c-2 10-12 16-18 20-6-4-16-10-18-20z" />
            <text x="22" y="28" text-anchor="middle">66</text>
          </g>
          <g class="ds-visit__map-pin" data-map-pin>
            <path d="M286 186c0-20 16-34 34-34s34 14 34 34c0 26-34 56-34 56s-34-30-34-56z" />
            <circle cx="320" cy="186" r="12" />
          </g>
        </svg>
        <figcaption class="ds-visit__map-caption">Mapa poglądowa. W gotowej stronie: mapa ładowana dopiero po kliknięciu.</figcaption>
      </figure>
    </div>
  </div>
</section>
