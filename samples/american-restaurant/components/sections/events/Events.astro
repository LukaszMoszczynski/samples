---
// Events: three regular evenings as chrome-rimmed tickets. On hover a card tilts toward the pointer and a chrome shine
// follows it (diner.js reads the pointer on the card's steady slot, never on the tilting card). A line about private
// parties closes the section.
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import DinerArt, { type Drawing } from '../../molecules/diner-art/DinerArt.astro';
import DinerButton from '../../atoms/diner-button/DinerButton.astro';
interface Props {
  id: string; eyebrow: string; title: string; lead: string;
  items: { drawing: Drawing; when: string; title: string; text: string; facts: string[] }[];
  party: { title: string; text: string; cta: { text: string; href: string } };
}
const { id, eyebrow, title, lead, items, party } = Astro.props;
---
<section class="ds-section ds-section--night ds-events" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head ds-section-head--center" data-reveal>
      <Eyebrow text={eyebrow} tone="night" />
      <h2 class="ds-section-head__title" id={`${id}-title`} set:html={title} />
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <ul class="ds-events__list" role="list">
      {items.map((item) => (
        <li class="ds-events__slot" data-tilt data-reveal>
          <article class="ds-events__card" data-tilt-card>
            <p class="ds-events__when">{item.when}</p>
            <div class="ds-events__art"><DinerArt name={item.drawing} tone="night" /></div>
            <h3 class="ds-events__title">{item.title}</h3>
            <p class="ds-events__text">{item.text}</p>
            <ul class="ds-events__facts" role="list">
              {item.facts.map((fact) => <li>{fact}</li>)}
            </ul>
            <span class="ds-events__shine" aria-hidden="true"></span>
          </article>
        </li>
      ))}
    </ul>
    <div class="ds-events__party" data-reveal>
      <div>
        <h3 class="ds-events__party-title">{party.title}</h3>
        <p class="ds-events__party-text">{party.text}</p>
      </div>
      <DinerButton text={party.cta.text} href={party.cta.href} variant="mint" icon="arrow" />
    </div>
  </div>
</section>
