---
// Reviews: example quotes, clearly marked as examples (section note and a badge on each card).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import ReviewCard from '../../molecules/review-card/ReviewCard.astro';
interface Props { id: string; label: string; title: string; lead: string; reviews: { quote: string; author: string; service: string; stars?: number }[]; score: { value: string; text: string } }
const { id, label, title, lead, reviews, score } = Astro.props;
---
<section class="ds-section ds-reviews" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-reviews__head" data-reveal>
      <div class="ds-section-head">
        <Eyebrow text={label} />
        <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
        <p class="ds-section-head__lead">{lead}</p>
      </div>
      <p class="ds-reviews__score"><strong>{score.value}</strong><span>{score.text}</span></p>
    </div>
    <ul class="ds-reviews__list" role="list">
      {reviews.map((review) => <li><ReviewCard {...review} /></li>)}
    </ul>
  </div>
</section>
