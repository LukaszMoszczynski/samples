---
// The team: four drawn portraits on a dark section. Cards tilt toward the pointer (barber.js).
import Eyebrow from '../../atoms/eyebrow/Eyebrow.astro';
import TeamCard from '../../molecules/team-card/TeamCard.astro';
type Person = { name: string; role: string; skills: string[]; years: string; variant: 'fade' | 'bob' | 'beard' | 'bun'; tone: 'copper' | 'brass' | 'clay' | 'smoke' };
interface Props { id: string; label: string; title: string; lead: string; people: Person[]; note: string }
const { id, label, title, lead, people, note } = Astro.props;
---
<section class="ds-section ds-section--dark ds-team" id={id} aria-labelledby={`${id}-title`}>
  <div class="ds-container">
    <div class="ds-section-head" data-reveal>
      <Eyebrow text={label} />
      <h2 class="ds-section-head__title" id={`${id}-title`}>{title}</h2>
      <p class="ds-section-head__lead">{lead}</p>
    </div>
    <ul class="ds-team__list" role="list">
      {people.map((person) => <li><TeamCard {...person} /></li>)}
    </ul>
    <p class="ds-team__note" data-reveal>{note}</p>
  </div>
</section>
